
@model IEnumerable<MocBrewManagement.ViewModels.StocktakeHistoryItemViewModel>

@{
    Layout = null;
    ViewBag.Title = "Lịch sử kiểm kê kho";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Lịch sử kiểm kê kho - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        body {
            background: #f6f3ef;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .main-container {
            max-width: 1250px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .page-card {
            background: white;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }

        .page-title {
            font-weight: 700;
            color: #563c2e;
        }

        .btn-brown {
            background: #79543b;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5d402d;
                color: white;
            }

        .table thead th {
            background: #f0e9e2;
            color: #563c2e;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .stocktake-code {
            font-weight: 700;
            color: #79543b;
        }

        .summary-card {
            border: 1px solid #eee5dd;
            border-radius: 10px;
            padding: 18px;
            height: 100%;
        }

        .summary-number {
            font-size: 25px;
            font-weight: 700;
            color: #79543b;
        }
    </style>
</head>

<body>

    <div class="main-container">

        <div class="page-card">

            <!-- TIÊU ĐỀ -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h3 class="page-title mb-2">
                        <i class="fa-solid fa-clipboard-list me-2"></i>
                        Lịch sử kiểm kê kho
                    </h3>

                    <div class="text-muted">
                        Danh sách các phiếu kiểm kê nguyên liệu đã được lưu.
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a href="@Url.Action("Index", "Ingredients")"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Quay lại kho
                    </a>

                    <a href="@Url.Action("Stocktake", "Ingredients")"
                       class="btn btn-brown">
                        <i class="fa-solid fa-plus me-1"></i>
                        Tạo phiếu kiểm kê
                    </a>

                </div>
            </div>

            <!-- THÔNG BÁO -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- THỐNG KÊ -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">Tổng số phiếu</div>
                        <div class="summary-number">
                            @(Model == null ? 0 : Model.Count())
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">Tổng nguyên liệu đã kiểm kê</div>
                        <div class="summary-number">
                            @(Model == null ? 0 : Model.Sum(x => x.TotalIngredients))
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">Tổng dòng có chênh lệch</div>
                        <div class="summary-number">
                            @(Model == null ? 0 : Model.Sum(x => x.ChangedIngredients))
                        </div>
                    </div>
                </div>

            </div>

            <!-- BẢNG PHIẾU -->
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead>
                        <tr>
                            <th class="text-center">STT</th>
                            <th>Mã phiếu kiểm kê</th>
                            <th>Ngày kiểm kê</th>
                            <th>Người thực hiện</th>
                            <th class="text-center">Số nguyên liệu</th>
                            <th class="text-center">Có chênh lệch</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @stt
                                    </td>

                                    <td>
                                        <span class="stocktake-code">
                                            @item.StocktakeCode
                                        </span>
                                    </td>

                                    <td>
                                        @item.StocktakeDate.ToString("dd/MM/yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.FullName
                                        </div>
                                        <small class="text-muted">
                                            @item.Username
                                        </small>
                                    </td>

                                    <td class="text-center">
                                        @item.TotalIngredients
                                    </td>

                                    <td class="text-center">
                                        @if (item.ChangedIngredients > 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.ChangedIngredients dòng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Không chênh lệch
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a href="@Url.Action("StocktakeDetails", "Ingredients", new { id = item.SessionId })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fa-2x mb-3"></i>
                                    <div>Chưa có phiếu kiểm kê nào được lưu.</div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="text-muted small mt-3">
                <i class="fa-solid fa-circle-info me-1"></i>
                Chọn "Xem chi tiết" để xem tồn kho hệ thống, tồn thực tế và số lượng chênh lệch.
            </div>

        </div>

    </div>

</body>
</html>
