
@model MocBrewManagement.ViewModels.StocktakeDetailViewModel

@{
    Layout = null;
    ViewBag.Title = "Chi tiết phiếu kiểm kê";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Chi tiết phiếu kiểm kê - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        body {
            background: #f6f3ef;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .main-container {
            max-width: 1300px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .page-card {
            background: white;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }

        .page-title {
            color: #563c2e;
            font-weight: 700;
        }

        .stocktake-code {
            color: #79543b;
            font-weight: 700;
            font-size: 20px;
        }

        .info-card {
            border: 1px solid #eee5dd;
            border-radius: 10px;
            padding: 17px;
            height: 100%;
        }

        .info-label {
            font-size: 13px;
            color: #888;
            margin-bottom: 7px;
        }

        .info-value {
            font-weight: 600;
            color: #49372c;
        }

        .summary-card {
            border-radius: 10px;
            padding: 18px;
            background: #faf8f5;
            border: 1px solid #eee5dd;
            height: 100%;
        }

        .summary-number {
            font-size: 25px;
            font-weight: 700;
            color: #79543b;
        }

        .table thead th {
            background: #f0e9e2;
            color: #563c2e;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .difference-positive {
            color: #198754;
            font-weight: 700;
        }

        .difference-negative {
            color: #dc3545;
            font-weight: 700;
        }

        .difference-zero {
            color: #6c757d;
            font-weight: 600;
        }

        .btn-brown {
            background: #79543b;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5d402d;
                color: white;
            }

        .note-box {
            background: #faf8f5;
            border-left: 4px solid #79543b;
            border-radius: 5px;
            padding: 15px;
        }
    </style>
</head>

<body>

    <div class="main-container">

        <div class="page-card">

            <!-- TIÊU ĐỀ -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h3 class="page-title mb-2">
                        <i class="fa-solid fa-clipboard-check me-2"></i>
                        Chi tiết phiếu kiểm kê
                    </h3>

                    <div class="stocktake-code">
                        @Model.StocktakeCode
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a href="@Url.Action("StocktakeHistory", "Ingredients")"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Danh sách phiếu
                    </a>

                    <button type="button"
                            onclick="window.print()"
                            class="btn btn-brown">
                        <i class="fa-solid fa-print me-1"></i>
                        In phiếu
                    </button>

                </div>

            </div>

            <!-- THÔNG TIN CHUNG -->
            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-circle-info me-2"></i>
                Thông tin phiếu kiểm kê
            </h5>

            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="info-card">
                        <div class="info-label">Mã phiếu</div>
                        <div class="info-value">@Model.StocktakeCode</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-card">
                        <div class="info-label">Ngày kiểm kê</div>
                        <div class="info-value">
                            @Model.StocktakeDate.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-card">
                        <div class="info-label">Người thực hiện</div>
                        <div class="info-value">@Model.FullName</div>
                        <small class="text-muted">@Model.Username</small>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-card">
                        <div class="info-label">Số nguyên liệu kiểm kê</div>
                        <div class="info-value">
                            @Model.TotalIngredients nguyên liệu
                        </div>
                    </div>
                </div>

            </div>

            <!-- GHI CHÚ CHUNG -->
            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-note-sticky me-2"></i>
                Ghi chú phiếu
            </h5>

            <div class="note-box mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.SessionNote))
                {
                    @Model.SessionNote
                }
                else
                {
                    <span class="text-muted">Không có ghi chú chung.</span>
                }
            </div>

            <!-- THỐNG KÊ -->
            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-chart-column me-2"></i>
                Tổng hợp kết quả kiểm kê
            </h5>

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">
                            Tổng nguyên liệu
                        </div>
                        <div class="summary-number">
                            @Model.TotalIngredients
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">
                            Nguyên liệu có chênh lệch
                        </div>
                        <div class="summary-number text-danger">
                            @Model.ChangedIngredients
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="summary-card">
                        <div class="text-muted mb-1">
                            Nguyên liệu không chênh lệch
                        </div>
                        <div class="summary-number text-success">
                            @Model.UnchangedIngredients
                        </div>
                    </div>
                </div>

            </div>

            <!-- CHI TIẾT NGUYÊN LIỆU -->
            <h5 class="fw-bold mb-3">
                <i class="fa-solid fa-boxes-stacked me-2"></i>
                Chi tiết số lượng kiểm kê
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th class="text-center">STT</th>
                            <th>Tên nguyên liệu</th>
                            <th class="text-center">Đơn vị</th>
                            <th class="text-end">Tồn hệ thống</th>
                            <th class="text-end">Tồn thực tế</th>
                            <th class="text-end">Chênh lệch</th>
                            <th>Ghi chú</th>
                            <th class="text-center">Kết quả</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int stt = 1;

                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td class="text-center">
                                        @stt
                                    </td>

                                    <td class="fw-semibold">
                                        @item.IngredientName
                                    </td>

                                    <td class="text-center">
                                        @item.Unit
                                    </td>

                                    <td class="text-end">
                                        @item.SystemStock.ToString("N3")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @item.ActualStock.ToString("N3")
                                    </td>

                                    <td class="text-end">

                                        @if (item.Difference > 0)
                                        {
                                            <span class="difference-positive">
                                                +@item.Difference.ToString("N3")
                                            </span>
                                        }
                                        else if (item.Difference < 0)
                                        {
                                            <span class="difference-negative">
                                                @item.Difference.ToString("N3")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="difference-zero">
                                                0.000
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Note)
                                        ? "—"
                                        : item.Note)
                                    </td>

                                    <td class="text-center">

                                        @if (item.Difference > 0)
                                        {
                                            <span class="badge bg-success">
                                                Thừa
                                            </span>
                                        }
                                        else if (item.Difference < 0)
                                        {
                                            <span class="badge bg-danger">
                                                Thiếu
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Khớp
                                            </span>
                                        }

                                    </td>

                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Phiếu chưa có dữ liệu chi tiết.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- CHÚ THÍCH -->
            <div class="mt-3 text-muted small">
                <div>
                    <span class="text-success fw-bold">+ Chênh lệch dương:</span>
                    Tồn thực tế lớn hơn tồn hệ thống (kiểm kê thừa).
                </div>

                <div>
                    <span class="text-danger fw-bold">- Chênh lệch âm:</span>
                    Tồn thực tế nhỏ hơn tồn hệ thống (kiểm kê thiếu).
                </div>

                <div>
                    <span class="text-secondary fw-bold">0.000:</span>
                    Số lượng thực tế khớp với hệ thống.
                </div>
            </div>

            <div class="text-end mt-4 text-muted small">
                Phiếu kiểm kê được lưu trong hệ thống MỘC BREW.
            </div>

        </div>

    </div>

    <style>
        @@media print {
            body {
                background: white !important;
            }

            .main-container {
                margin: 0;
                max-width: 100%;
                padding: 0;
            }

            .page-card {
                box-shadow: none;
                padding: 10px;
            }

            .btn,
            a {
                display: none !important;
            }
        }
    </style>

</body>
</html>
