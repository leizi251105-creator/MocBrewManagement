
@model MocBrewManagement.ViewModels.IngredientEditViewModel

@{
    ViewBag.Title = "Sửa nguyên liệu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sửa nguyên liệu - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f2ee;
            font-family: Arial, sans-serif;
            color: #3e3028;
        }

        .page-container {
            max-width: 850px;
            margin: 45px auto;
            padding: 0 18px;
        }

        .form-card {
            background: #fff;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 4px 18px rgba(0,0,0,.06);
        }

        .page-title {
            color: #563b2d;
            font-weight: 700;
        }

        .btn-brown {
            background: #654332;
            color: #fff;
            border: none;
        }

            .btn-brown:hover {
                background: #4c3024;
                color: #fff;
            }

        .form-label {
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="page-container">

        <div class="mb-4">
            <a href="@Url.Action("Index", "Ingredients")"
               class="text-decoration-none text-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại kho nguyên liệu
            </a>
        </div>

        <div class="form-card">
            <div class="mb-4">
                <h3 class="page-title">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Sửa thông tin nguyên liệu
                </h3>
                <p class="text-muted mb-0">
                    Cập nhật thông tin nguyên liệu trong hệ thống MỘC BREW.
                </p>
            </div>

            @using (Html.BeginForm("Edit", "Ingredients", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IngredientId)

                @Html.ValidationSummary(false, "", new
                {
                    @class = "alert alert-danger"
                })

                <div class="mb-3">
                    @Html.LabelFor(m => m.IngredientName,
                             new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.IngredientName,
                             new { @class = "form-control", placeholder = "Nhập tên nguyên liệu" })

                    @Html.ValidationMessageFor(m => m.IngredientName,
                             "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Unit,
                             new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Unit,
                             new { @class = "form-control", placeholder = "Ví dụ: kg, lít, hộp, cái" })

                    @Html.ValidationMessageFor(m => m.Unit,
                             "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.MinimumStock,
                             new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.MinimumStock,
                             new { @class = "form-control", type = "number", step = "0.001", min = "0" })

                    @Html.ValidationMessageFor(m => m.MinimumStock,
                             "", new { @class = "text-danger" })

                    <small class="text-muted">
                        Khi tồn kho bằng hoặc thấp hơn mức này, hệ thống sẽ cảnh báo sắp hết hàng.
                    </small>
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Description,
                             new { @class = "form-label" })

                    @Html.TextAreaFor(m => m.Description,
                             new { @class = "form-control", rows = "4", placeholder = "Nhập mô tả nguyên liệu (nếu có)" })

                    @Html.ValidationMessageFor(m => m.Description,
                             "", new { @class = "text-danger" })
                </div>

                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Số lượng tồn kho không thể chỉnh sửa tại đây.
                    Vui lòng sử dụng chức năng nhập kho hoặc kiểm kê để cập nhật tồn kho.
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index", "Ingredients")"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-brown">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
