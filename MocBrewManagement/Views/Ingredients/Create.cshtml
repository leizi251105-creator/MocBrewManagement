
@model MocBrewManagement.ViewModels.IngredientCreateViewModel

@{
    ViewBag.Title = "Thêm nguyên liệu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Thêm nguyên liệu - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f7f5f1;
            font-family: Arial, sans-serif;
            color: #382b23;
        }

        .main {
            max-width: 850px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .form-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            color: #513629;
            font-weight: 700;
        }

        .btn-brown {
            background: #704b35;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #513629;
                color: white;
            }

        .form-label {
            font-weight: 600;
            color: #513629;
        }

        .required {
            color: #dc3545;
        }

        .note-box {
            background: #f8f3ed;
            border-left: 4px solid #9b7657;
            padding: 14px;
            border-radius: 6px;
            color: #6b584a;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <div class="main">

        <div class="mb-4">
            <h2 class="page-title">
                <i class="fa-solid fa-circle-plus me-2"></i>
                Thêm nguyên liệu mới
            </h2>

            <p class="text-muted">
                Khai báo thông tin nguyên liệu sử dụng trong cửa hàng MỘC BREW.
            </p>
        </div>

        <div class="form-card">

            @using (Html.BeginForm("Create", "Ingredients", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label">
                        Tên nguyên liệu <span class="required">*</span>
                    </label>

                    @Html.TextBoxFor(m => m.IngredientName,
                             new
                             {
                                 @class = "form-control",
                                 placeholder = "Ví dụ: Hạt cà phê Arabica"
                             })

                    @Html.ValidationMessageFor(m => m.IngredientName,
                             "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Đơn vị tính <span class="required">*</span>
                    </label>

                    @Html.TextBoxFor(m => m.Unit,
                             new
                             {
                                 @class = "form-control",
                                 placeholder = "Ví dụ: kg, gram, ml, chai, hộp"
                             })

                    @Html.ValidationMessageFor(m => m.Unit,
                             "", new { @class = "text-danger small" })
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Số lượng tồn ban đầu
                        </label>

                        @Html.TextBoxFor(m => m.CurrentStock,
                                 new
                                 {
                                     @class = "form-control",
                                     type = "number",
                                     step = "0.001",
                                     min = "0"
                                 })

                        @Html.ValidationMessageFor(m => m.CurrentStock,
                                 "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Mức tồn kho tối thiểu
                        </label>

                        @Html.TextBoxFor(m => m.MinimumStock,
                                 new
                                 {
                                     @class = "form-control",
                                     type = "number",
                                     step = "0.001",
                                     min = "0"
                                 })

                        @Html.ValidationMessageFor(m => m.MinimumStock,
                                 "", new { @class = "text-danger small" })
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả</label>

                    @Html.TextAreaFor(m => m.Description,
                             new
                             {
                                 @class = "form-control",
                                 rows = "4",
                                 placeholder = "Thông tin bổ sung về nguyên liệu..."
                             })

                    @Html.ValidationMessageFor(m => m.Description,
                             "", new { @class = "text-danger small" })
                </div>

                <div class="note-box mb-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Số lượng tồn ban đầu sẽ được ghi nhận vào lịch sử giao dịch kho.
                    Sau khi tạo nguyên liệu, việc thay đổi tồn kho cần thực hiện
                    thông qua nghiệp vụ nhập kho hoặc điều chỉnh kho.
                </div>

                <div class="d-flex justify-content-between flex-wrap gap-2">

                    <a href="@Url.Action("Index", "Ingredients")"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <button type="submit" class="btn btn-brown px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Lưu nguyên liệu
                    </button>

                </div>
            }

        </div>

    </div>

</body>
</html>
