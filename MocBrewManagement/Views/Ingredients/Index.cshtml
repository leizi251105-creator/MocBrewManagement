
@model IEnumerable<MocBrewManagement.ViewModels.IngredientViewModel>
@using System.Linq

@{
    ViewBag.Title = "Quản lý kho và nguyên liệu";
    Layout = null;

    var ingredients = Model.ToList();

    int totalIngredients = ingredients.Count;
    int activeIngredients = ingredients.Count(x => x.IsActive);
    int inactiveIngredients = ingredients.Count(x => !x.IsActive);
    int lowStockIngredients = ingredients.Count(x => x.IsActive && x.IsLowStock);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Quản lý kho và nguyên liệu - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f7f5f1;
            font-family: Arial, sans-serif;
            color: #382b23;
        }

        .main {
            max-width: 1200px;
            margin: auto;
            padding: 35px;
        }

        .page-title {
            color: #513629;
            font-weight: 700;
        }

        .subtitle {
            color: #81766e;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.05);
            height: 100%;
        }

        .stat-label {
            color: #81766e;
            font-size: 14px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: bold;
            margin-top: 8px;
            color: #513629;
        }

        .content-card {
            background: white;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        }

        .btn-brown {
            background: #704b35;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #513629;
                color: white;
            }

        .table th {
            background: #f5f0eb;
            color: #513629;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .status-active {
            background: #e4f4e9;
            color: #237443;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-inactive {
            background: #f1eeee;
            color: #777;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .low-stock {
            color: #c0392b;
            font-weight: bold;
        }

        .normal-stock {
            color: #237443;
            font-weight: bold;
        }

        .empty-state {
            padding: 45px 15px;
            text-align: center;
            color: #81766e;
        }

        @@media (max-width: 768px) {
            .main {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
    <div class="main">

        <!-- TIÊU ĐỀ -->
        <div class="mb-4">
            <h2 class="page-title">
                <i class="fa-solid fa-boxes-stacked me-2"></i>
                Quản lý kho và nguyên liệu
            </h2>

            <p class="subtitle">
                Theo dõi nguyên liệu, số lượng tồn kho và tình trạng sử dụng.
            </p>
        </div>

        <div class="mb-4">
            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none text-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại Dashboard
            </a>
        </div>


        <!-- THỐNG KÊ -->
        <div class="row g-3 mb-4">

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-label">Tổng nguyên liệu</div>
                    <div class="stat-number">@totalIngredients</div>
                    <i class="fa-solid fa-box text-secondary mt-2"></i>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-label">Đang hoạt động</div>
                    <div class="stat-number text-success">@activeIngredients</div>
                    <i class="fa-solid fa-circle-check text-success mt-2"></i>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-label">Ngừng hoạt động</div>
                    <div class="stat-number text-secondary">@inactiveIngredients</div>
                    <i class="fa-solid fa-circle-pause text-secondary mt-2"></i>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-label">Sắp hết hàng</div>
                    <div class="stat-number text-danger">@lowStockIngredients</div>
                    <i class="fa-solid fa-triangle-exclamation text-danger mt-2"></i>
                </div>
            </div>

        </div>

        <!-- DANH SÁCH NGUYÊN LIỆU -->

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng"></button>
            </div>
        }

        <div class="content-card">



            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

                <div>
                    <h5 class="fw-bold mb-1">Danh sách nguyên liệu</h5>
                    <small class="text-muted">
                        Theo dõi số lượng tồn kho và tình trạng nguyên liệu.
                    </small>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    @if (Session["MOCBREW_RoleId"] != null &&
                         (Convert.ToInt32(Session["MOCBREW_RoleId"]) == 1 ||
                          Convert.ToInt32(Session["MOCBREW_RoleId"]) == 2 ||
                          (Convert.ToInt32(Session["MOCBREW_RoleId"]) == 3 &&
                           Session["MOCBREW_AccountId"] != null &&
                           Model != null)))
                    {
                        if (Convert.ToInt32(Session["MOCBREW_RoleId"]) == 1 ||
                            Convert.ToInt32(Session["MOCBREW_RoleId"]) == 2)
                        {
                            <a href="@Url.Action("Stocktake", "Ingredients")"
                               class="btn btn-outline-success">
                                <i class="fa-solid fa-clipboard-check me-1"></i>
                                Kiểm kê kho
                            </a>
                            <a href="@Url.Action("StocktakeHistory", "Ingredients")"
                               class="btn btn-outline-primary">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                                Lịch sử kiểm kê
                            </a>
                        }
                    }

                    @if (Session["MOCBREW_RoleId"] != null &&
                         Convert.ToInt32(Session["MOCBREW_RoleId"]) == 1)
                    {
                        <a href="@Url.Action("Create", "Ingredients")"
                           class="btn btn-brown">
                            <i class="fa-solid fa-plus me-1"></i>
                            Thêm nguyên liệu
                        </a>
                    }

                </div>
            </div>



            <!-- TÌM KIẾM VÀ LỌC -->
            <form method="get" action="@Url.Action("Index", "Ingredients")"
                  class="row g-2 mb-4">

                <div class="col-md-5">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Nhập tên nguyên liệu cần tìm..."
                           value="@ViewBag.Search" />
                </div>

                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="all"
                                @(ViewBag.Status == "all" ? "selected" : "")>
                            Tất cả trạng thái
                        </option>

                        <option value="active"
                                @(ViewBag.Status == "active" ? "selected" : "")>
                            Đang hoạt động
                        </option>

                        <option value="inactive"
                                @(ViewBag.Status == "inactive" ? "selected" : "")>
                            Ngừng hoạt động
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-brown w-100">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>
                        Tìm kiếm
                    </button>
                </div>

                <div class="col-md-2">
                    <a href="@Url.Action("Index", "Ingredients")"
                       class="btn btn-outline-secondary w-100">
                        <i class="fa-solid fa-rotate-left me-1"></i>
                        Làm mới
                    </a>
                </div>

            </form>

            <!-- BẢNG DỮ LIỆU -->
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th style="width: 60px;">STT</th>
                            <th>Tên nguyên liệu</th>
                            <th>Đơn vị</th>
                            <th class="text-end">Tồn kho</th>
                            <th class="text-end">Tồn tối thiểu</th>
                            <th>Trạng thái kho</th>
                            <th>Hoạt động</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (ingredients.Any())
                        {
                            int stt = 1;

                            foreach (var item in ingredients)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.IngredientName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted">
                                                @item.Description
                                            </small>
                                        }
                                    </td>

                                    <td>@item.Unit</td>

                                    <td class="text-end fw-bold">
                                        @item.CurrentStock.ToString("N3")
                                    </td>

                                    <td class="text-end">
                                        @item.MinimumStock.ToString("N3")
                                    </td>

                                    <td>
                                        @if (!item.IsActive)
                                        {
                                            <span class="text-muted">Không áp dụng</span>
                                        }
                                        else if (item.IsLowStock)
                                        {
                                            <span class="low-stock">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                Sắp hết hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="normal-stock">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Đủ hàng
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-active">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">Ngừng hoạt động</span>
                                        }
                                    </td>


                                    <!-- THAO TÁC -->
                                    <td class="text-center">
                                        @if (Session["MOCBREW_RoleId"] != null &&
                                             Convert.ToInt32(Session["MOCBREW_RoleId"]) == 1)
                                        {
                                            <div class="d-flex justify-content-center gap-1">

                                                <a href="@Url.Action("Edit", "Ingredients", new { id = item.IngredientId })"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Sửa nguyên liệu">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                    Sửa
                                                </a>

                                                @using (Html.BeginForm("ToggleStatus", "Ingredients",
                                                    new { id = item.IngredientId }, FormMethod.Post,
                                                    new { onsubmit = "return confirm('Bạn có chắc chắn muốn thay đổi trạng thái nguyên liệu này?');" }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    if (item.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                title="Ngừng hoạt động">
                                                            <i class="fa-solid fa-ban"></i>
                                                            Ngừng
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                title="Mở lại nguyên liệu">
                                                            <i class="fa-solid fa-rotate-left"></i>
                                                            Mở lại
                                                        </button>
                                                    }
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>


                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="fa-solid fa-box-open fa-3x mb-3"></i>

                                        <h6>Chưa có nguyên liệu nào</h6>

                                        <p class="mb-0">
                                            Không tìm thấy dữ liệu phù hợp.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="text-muted small mt-3">
                Hiển thị @ingredients.Count nguyên liệu.
            </div>

        </div>

        <div class="text-center text-muted small mt-4">
            MỘC BREW - Hệ thống quản lý cửa hàng
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
