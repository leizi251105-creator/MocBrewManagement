
@model MocBrewManagement.ViewModels.StocktakeViewModel

@{
    ViewBag.Title = "Kiểm kê kho nguyên liệu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Kiểm kê kho - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f2ee;
            font-family: Arial, sans-serif;
            color: #3e3028;
        }

        .page-container {
            max-width: 1200px;
            margin: 35px auto;
            padding: 0 18px;
        }

        .main-card {
            background: #fff;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 4px 18px rgba(0,0,0,.06);
        }

        .page-title {
            color: #563b2d;
            font-weight: 700;
        }

        .btn-brown {
            background: #654332;
            color: #fff;
            border: none;
        }

            .btn-brown:hover {
                background: #4c3024;
                color: #fff;
            }

        .stock-input {
            max-width: 160px;
            margin-left: auto;
        }

        .system-stock {
            font-weight: 700;
            color: #654332;
        }

        .difference {
            font-weight: 700;
        }

        .difference-positive {
            color: #198754;
        }

        .difference-negative {
            color: #dc3545;
        }

        .difference-zero {
            color: #6c757d;
        }

        .table thead th {
            background: #f4eee9;
            color: #563b2d;
            white-space: nowrap;
        }

        .note-input {
            min-width: 180px;
        }
    </style>
</head>

<body>

    <div class="page-container">

        <div class="mb-4">
            <a href="@Url.Action("Index", "Ingredients")"
               class="text-decoration-none text-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại kho nguyên liệu
            </a>
        </div>

        <div class="main-card">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h3 class="page-title">
                        <i class="fa-solid fa-clipboard-check me-2"></i>
                        Kiểm kê kho nguyên liệu
                    </h3>

                    <p class="text-muted mb-0">
                        Nhập số lượng thực tế sau khi kiểm đếm nguyên liệu.
                    </p>
                </div>

                <div class="text-muted">
                    <i class="fa-regular fa-calendar me-1"></i>
                    @Model.StocktakeDate.ToString("dd/MM/yyyy HH:mm")
                </div>

            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="alert alert-info">
                <i class="fa-solid fa-circle-info me-2"></i>
                Tồn kho hệ thống được hiển thị để đối chiếu.
                Bạn chỉ cần nhập số lượng thực tế. Hệ thống tự tính chênh lệch.
            </div>

            @using (Html.BeginForm("Stocktake", "Ingredients", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th style="width: 55px;">STT</th>
                                <th>Tên nguyên liệu</th>
                                <th>Đơn vị</th>
                                <th class="text-end">Tồn hệ thống</th>
                                <th class="text-end">Tồn thực tế</th>
                                <th class="text-end">Chênh lệch</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>

                        <tbody>

                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>

                                    <td>
                                        <strong>@Model.Items[i].IngredientName</strong>
                                    </td>

                                    <td>@Model.Items[i].Unit</td>

                                    <td class="text-end system-stock">
                                        @Model.Items[i].SystemStock.ToString("N3")
                                    </td>

                                    <td class="text-end">
                                        @Html.HiddenFor(m => m.Items[i].IngredientId)

                                        @Html.HiddenFor(m => m.Items[i].IngredientName)

                                        @Html.HiddenFor(m => m.Items[i].Unit)

                                        @Html.HiddenFor(m => m.Items[i].SystemStock)

                                        @Html.TextBoxFor(
                                                 m => m.Items[i].ActualStock,
                                                 new
                                                 {
                                                     @class = "form-control form-control-sm stock-input actual-stock",
                                                     type = "number",
                                                     min = "0",
                                                     step = "0.001"
                                                 })
                                    </td>

                                    <td class="text-end">
                                        <span class="difference difference-zero"
                                              id="difference_@i">
                                            0.000
                                        </span>
                                    </td>

                                    <td>
                                        @Html.TextBoxFor(
                                                 m => m.Items[i].Note,
                                                 new
                                                 {
                                                     @class = "form-control form-control-sm note-input",
                                                     placeholder = "Lý do chênh lệch..."
                                                 })
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Ghi chú chung cho phiếu kiểm kê
                    </label>

                    @Html.TextAreaFor(
                             m => m.Note,
                             new
                             {
                                 @class = "form-control",
                                 rows = "3",
                                 placeholder = "Nhập ghi chú chung nếu cần..."
                             })
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <a href="@Url.Action("Index", "Ingredients")"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-brown"
                            onclick="return confirm('Bạn có chắc chắn muốn lưu kết quả kiểm kê và cập nhật tồn kho?');">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Xác nhận kiểm kê
                    </button>

                </div>
            }

        </div>

        <div class="text-center text-muted small mt-4">
            MỘC BREW - Hệ thống quản lý cửa hàng
        </div>

    </div>

    <script>document.addEventListener("DOMContentLoaded", function () {

            const inputs = document.querySelectorAll(".actual-stock");

            inputs.forEach(function (input) {

                function calculateDifference() {

                    const row = input.closest("tr");

                    const systemStock = parseFloat(
                        row.querySelector("td:nth-child(4)").innerText
                            .replace(/,/g, "")
                    ) || 0;

                    const actualStock = parseFloat(input.value) || 0;

                    const difference = actualStock - systemStock;

                    const index = Array.from(
                        row.parentElement.children
                    ).indexOf(row);

                    const result = document.getElementById(
                        "difference_" + index
                    );

                    result.textContent = difference.toFixed(3);

                    result.className = "difference";

                    if (difference > 0) {
                        result.classList.add("difference-positive");
                        result.textContent = "+" + difference.toFixed(3);
                    }
                    else if (difference < 0) {
                        result.classList.add("difference-negative");
                    }
                    else {
                        result.classList.add("difference-zero");
                    }
                }

                input.addEventListener("input", calculateDifference);

                calculateDifference();
            });

        });</script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
