
@model MocBrewManagement.ViewModels.RecipeCreateEditViewModel

@{
    ViewBag.Title = "Chỉnh sửa công thức pha chế";
    Layout = null;

    var ingredients = ViewBag.Ingredients
        as List<MocBrewManagement.ViewModels.RecipeIngredientViewModel>;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chỉnh sửa công thức - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6f8;
            font-family: Arial, sans-serif;
            color: #263238;
        }

        .main-container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 22px;
        }

        .page-title {
            color: #493324;
            font-weight: 700;
        }

        .form-card {
            background: white;
            border-radius: 14px;
            padding: 26px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
        }

        .section-title {
            color: #654321;
            font-weight: 700;
            border-bottom: 1px solid #eee;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        .btn-brown {
            background: #795548;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5d4037;
                color: white;
            }

        .ingredient-row {
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
        }

        .required {
            color: #dc3545;
        }
    </style>
</head>

<body>
    <div class="main-container">

        <div class="mb-4">
            <a href="@Url.Action("Index", "Recipes")"
               class="text-decoration-none text-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại danh sách công thức
            </a>
        </div>

        <div class="mb-4">
            <h2 class="page-title">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Chỉnh sửa công thức pha chế
            </h2>
            <div class="text-secondary">
                Cập nhật nguyên liệu và định lượng cho sản phẩm.
            </div>
        </div>

        <div class="form-card">

            @using (Html.BeginForm("Edit", "Recipes", FormMethod.Post,
                new { id = "recipeForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.RecipeId)
                @Html.HiddenFor(m => m.IsActive)

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <h5 class="section-title">
                    <i class="fa-solid fa-mug-hot me-2"></i>
                    Thông tin công thức
                </h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Sản phẩm và size <span class="required">*</span>
                    </label>

                    @Html.DropDownListFor(
                             m => m.ProductSizeId,
                             (SelectList)ViewBag.ProductSizes,
                             "-- Chọn sản phẩm và size --",
                             new { @class = "form-select" }
                         )

                    @Html.ValidationMessageFor(
                             m => m.ProductSizeId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô tả công thức</label>

                    @Html.TextAreaFor(
                             m => m.Description,
                             new
                             {
                                 @class = "form-control",
                                 rows = 3,
                                 placeholder = "Nhập mô tả công thức pha chế..."
                             })
                </div>

                <h5 class="section-title">
                    <i class="fa-solid fa-list-check me-2"></i>
                    Danh sách nguyên liệu
                </h5>

                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Định lượng là lượng nguyên liệu sử dụng cho một sản phẩm theo size đã chọn.
                </div>

                <div id="ingredientContainer">

                    @if (Model.Ingredients != null)
                    {
                        for (int i = 0; i < Model.Ingredients.Count; i++)
                        {
                            var currentId = Model.Ingredients[i].IngredientId;

                            var selectedIngredient = ingredients == null
                                ? null
                                : ingredients.FirstOrDefault(x => x.IngredientId == currentId);

                            <div class="ingredient-row">
                                <div class="row g-3 align-items-end">

                                    <div class="col-md-7">
                                        <label class="form-label fw-bold">Nguyên liệu</label>

                                        <select name="Ingredients[@i].IngredientId"
                                                class="form-select ingredient-select"
                                                required>
                                            <option value="">-- Chọn nguyên liệu --</option>

                                            @if (ingredients != null)
                                            {
                                                foreach (var ingredient in ingredients)
                                                {
                                                    <option value="@ingredient.IngredientId"
                                                            @(ingredient.IngredientId == currentId ? "selected" : "")>
                                                        @ingredient.IngredientName (@ingredient.Unit)
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">Định lượng</label>

                                        <input type="number"
                                               name="Ingredients[@i].QuantityRequired"
                                               class="form-control"
                                               value="@Model.Ingredients[i].QuantityRequired.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               min="0.001"
                                               step="0.001"
                                               required />
                                    </div>

                                    <div class="col-md-2">
                                        <button type="button"
                                                class="btn btn-outline-danger w-100 remove-ingredient">
                                            <i class="fa-solid fa-trash"></i>
                                            Xóa
                                        </button>
                                    </div>

                                </div>
                            </div>
                        }
                    }

                </div>

                <button type="button"
                        class="btn btn-outline-primary mb-4"
                        id="addIngredient">
                    <i class="fa-solid fa-plus me-2"></i>
                    Thêm nguyên liệu
                </button>

                <hr />

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="@Url.Action("Index", "Recipes")"
                       class="btn btn-outline-secondary px-4">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-brown px-4">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>

    <script>
        const ingredientOptions = `
            <option value="">-- Chọn nguyên liệu --</option>
            @if (ingredients != null)
            {
                foreach (var ingredient in ingredients)
                {
                    <option value="@ingredient.IngredientId">
                        @Html.Raw(HttpUtility.HtmlEncode(ingredient.IngredientName))
                        (@Html.Raw(HttpUtility.HtmlEncode(ingredient.Unit)))
                    </option>
                }
            }
        `;

        let ingredientIndex =
            document.querySelectorAll("#ingredientContainer .ingredient-row").length;

        document.getElementById("addIngredient").addEventListener("click", function () {
            const container = document.getElementById("ingredientContainer");

            const row = document.createElement("div");
            row.className = "ingredient-row";

            row.innerHTML = `
                <div class="row g-3 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label fw-bold">Nguyên liệu</label>
                        <select name="Ingredients[${ingredientIndex}].IngredientId"
                                class="form-select ingredient-select" required>
                            ${ingredientOptions}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Định lượng</label>
                        <input type="number"
                               name="Ingredients[${ingredientIndex}].QuantityRequired"
                               class="form-control"
                               min="0.001"
                               step="0.001"
                               required />
                    </div>

                    <div class="col-md-2">
                        <button type="button"
                                class="btn btn-outline-danger w-100 remove-ingredient">
                            <i class="fa-solid fa-trash"></i> Xóa
                        </button>
                    </div>
                </div>
            `;

            container.appendChild(row);
            ingredientIndex++;
        });

        document.getElementById("ingredientContainer").addEventListener("click", function (event) {
            const button = event.target.closest(".remove-ingredient");

            if (button) {
                const rows = document.querySelectorAll("#ingredientContainer .ingredient-row");

                if (rows.length <= 1) {
                    alert("Công thức phải có ít nhất một nguyên liệu.");
                    return;
                }

                button.closest(".ingredient-row").remove();
            }
        });

        document.getElementById("recipeForm").addEventListener("submit", function (event) {
            const rows = document.querySelectorAll("#ingredientContainer .ingredient-row");

            if (rows.length === 0) {
                event.preventDefault();
                alert("Công thức phải có ít nhất một nguyên liệu.");
                return;
            }

            const selectedIds = [];

            for (const row of rows) {
                const select = row.querySelector(".ingredient-select");
                const quantity = row.querySelector("input[type='number']");

                if (!select.value || !quantity.value || Number(quantity.value) <= 0) {
                    event.preventDefault();
                    alert("Vui lòng chọn nguyên liệu và nhập định lượng hợp lệ.");
                    return;
                }

                if (selectedIds.includes(select.value)) {
                    event.preventDefault();
                    alert("Không được chọn trùng nguyên liệu.");
                    return;
                }

                selectedIds.push(select.value);
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
