
@model IEnumerable<MocBrewManagement.ViewModels.RecipeViewModel>

@{
    ViewBag.Title = "Quản lý công thức pha chế";
    Layout = null;

    var roleId = Session["MOCBREW_RoleId"] == null
        ? 0
        : Convert.ToInt32(Session["MOCBREW_RoleId"]);

    bool canManage = ViewBag.CanManageRecipes != null
     && (bool)ViewBag.CanManageRecipes;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý công thức pha chế - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6f8;
            font-family: Arial, sans-serif;
            color: #263238;
        }

        .main-container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 22px;
        }

        .page-title {
            font-weight: 700;
            color: #493324;
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 3px 15px rgba(0,0,0,.04);
            height: 100%;
        }

        .stat-number {
            font-size: 27px;
            font-weight: 700;
            color: #795548;
        }

        .table-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 3px 15px rgba(0,0,0,.04);
        }

        .table thead th {
            background: #f4eee9;
            color: #493324;
            white-space: nowrap;
            font-size: 13px;
        }

        .table td {
            vertical-align: middle;
        }

        .btn-brown {
            background: #795548;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5d4037;
                color: white;
            }

        .product-name {
            font-weight: 700;
        }

        .size-badge {
            background: #eee4dc;
            color: #654321;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="main-container">

        <div class="mb-4">
            <a href="@Url.Action("Index", "Home")"
               class="text-decoration-none text-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại Dashboard
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title">
                    <i class="fa-solid fa-book-open me-2"></i>
                    Công thức pha chế
                </h2>
                <div class="text-secondary">
                    Quản lý định lượng nguyên liệu theo từng sản phẩm và size.
                </div>
            </div>

            @if (canManage)
            {
                <a href="@Url.Action("Create", "Recipes")"
                   class="btn btn-brown px-4 py-2">
                    <i class="fa-solid fa-plus me-2"></i>
                    Thêm công thức
                </a>
            }
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Tổng số công thức</div>
                    <div class="stat-number">@Model.Count()</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Công thức đang hoạt động</div>
                    <div class="stat-number">
                        @Model.Count(x => x.IsActive)
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Tổng lượt nguyên liệu</div>
                    <div class="stat-number">
                        @Model.Sum(x => x.TotalIngredients)
                    </div>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0 fw-bold">Danh sách công thức</h5>

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       style="max-width:300px"
                       placeholder="Tìm sản phẩm hoặc size..." />
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle" id="recipeTable">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Sản phẩm</th>
                            <th>Size</th>
                            <th>Mô tả</th>
                            <th>Nguyên liệu</th>
                            <th>Trạng thái</th>
                            @if (canManage)
                            {
                                <th>Thao tác</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="product-name">@item.ProductName</td>
                                <td>
                                    <span class="size-badge">
                                        @item.SizeName
                                    </span>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "Chưa có mô tả"
                                    : item.Description)
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.TotalIngredients nguyên liệu
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>

                                @if (canManage)
                                {
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="@Url.Action("Edit", "Recipes",
                                                new { id = item.RecipeId })"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Chỉnh sửa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>

                                            @using (Html.BeginForm("ToggleStatus", "Recipes",
                                                new { id = item.RecipeId },
                                                FormMethod.Post,
                                                new { onsubmit = "return confirm('Bạn có chắc chắn muốn thay đổi trạng thái công thức?');" }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                        title="@(item.IsActive ? "Ngừng hoạt động" : "Mở lại")">
                                                    <i class="fa-solid @(item.IsActive ? "fa-ban" : "fa-rotate-left")"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>

                            stt++;
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-secondary py-4">
                                    Chưa có công thức pha chế.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>document.getElementById("searchInput").addEventListener("keyup", function () {
            var keyword = this.value.toLowerCase();
            var rows = document.querySelectorAll("#recipeTable tbody tr");

            rows.forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(keyword)
                    ? ""
                    : "none";
            });
        });</script>
</body>
</html>
