
@model MocBrewManagement.Models.ProductViewModel

@{
    ViewBag.Title = "Quản lý sản phẩm và thực đơn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f2ed;
            font-family: 'Segoe UI', sans-serif;
            color: #38291f;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 245px;
            background: #30231d;
            color: white;
            padding: 25px 17px;
            z-index: 100;
        }

        .brand {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: 2px;
            text-align: center;
            color: #e5c59a;
            margin-bottom: 5px;
        }

        .brand-sub {
            text-align: center;
            color: #b9a99d;
            font-size: 11px;
            letter-spacing: 3px;
            margin-bottom: 35px;
        }

        .menu-label {
            color: #a99789;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            margin: 20px 10px 10px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #ded3ca;
            text-decoration: none;
            padding: 12px 13px;
            border-radius: 9px;
            margin-bottom: 5px;
            font-size: 14px;
            transition: .2s;
        }

            .sidebar a:hover,
            .sidebar a.active {
                background: #6d4c3b;
                color: #fff;
            }

            .sidebar a i {
                width: 19px;
                text-align: center;
            }

        .main {
            margin-left: 245px;
            padding: 30px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .page-title {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

        .page-subtitle {
            color: #8a786b;
            font-size: 13px;
            margin-top: 5px;
        }

        .user-info {
            background: white;
            padding: 10px 16px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
            font-size: 13px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(60,40,25,.04);
            border: 1px solid #eee7df;
        }

        .stat-title {
            color: #89796d;
            font-size: 13px;
        }

        .stat-number {
            font-size: 27px;
            font-weight: 800;
            margin-top: 7px;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3e8dc;
            color: #80583e;
            font-size: 18px;
        }

        .content-card {
            background: white;
            border-radius: 16px;
            padding: 23px;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(60,40,25,.04);
            border: 1px solid #eee7df;
        }

        .filter-input {
            border: 1px solid #e5ddd5;
            border-radius: 9px;
            padding: 10px 13px;
            font-size: 13px;
        }

        .btn-brown {
            background: #65452f;
            color: white;
            border: none;
            border-radius: 9px;
            padding: 10px 17px;
            font-size: 13px;
            font-weight: 600;
        }

            .btn-brown:hover {
                background: #493020;
                color: white;
            }

        .btn-light-brown {
            background: #f2e9e0;
            color: #65452f;
            border: none;
            border-radius: 9px;
            padding: 9px 13px;
            font-size: 13px;
        }

        .product-table {
            vertical-align: middle;
            font-size: 13px;
        }

            .product-table thead th {
                background: #f8f5f1;
                color: #756254;
                font-weight: 700;
                padding: 14px 10px;
                border-bottom: 1px solid #e9e1d8;
                white-space: nowrap;
            }

            .product-table tbody td {
                padding: 13px 10px;
                border-bottom: 1px solid #f0ebe5;
            }

        .product-image {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 10px;
            background: #f2ece5;
        }

        .image-placeholder {
            width: 55px;
            height: 55px;
            border-radius: 10px;
            background: #f2ece5;
            color: #a48a75;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .product-name {
            font-weight: 700;
            color: #443126;
        }

        .category-text {
            color: #857468;
            font-size: 12px;
            margin-top: 4px;
        }

        .status-active {
            color: #26764d;
            background: #e4f4e9;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .status-inactive {
            color: #a34c42;
            background: #fbe9e7;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .featured {
            color: #a06a12;
            background: #fff2d5;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
        }

        .normal-label {
            color: #8b8077;
            font-size: 11px;
        }

        .pagination .page-link {
            color: #65452f;
            border-color: #eee7df;
            font-size: 13px;
        }

        .pagination .active .page-link {
            background: #65452f;
            border-color: #65452f;
            color: white;
        }

        .empty-state {
            padding: 55px 15px;
            text-align: center;
            color: #938477;
        }

            .empty-state i {
                font-size: 38px;
                margin-bottom: 15px;
                color: #c5b3a3;
            }

        @@media (max-width: 900px) {
            .sidebar {
                width: 75px;
                padding: 20px 10px;
            }

            .brand {
                font-size: 13px;
                letter-spacing: 0;
            }

            .brand-sub,
            .menu-label,
            .sidebar a span {
                display: none;
            }

            .sidebar a {
                justify-content: center;
                padding: 13px 5px;
            }

            .main {
                margin-left: 75px;
                padding: 20px;
            }
        }

        @@media (max-width: 600px) {
            .main {
                padding: 13px;
            }

            .content-card {
                padding: 14px;
            }
        }
    </style>
</head>

<body>

    <!-- MAIN CONTENT -->
    <main class="main">

        <div class="topbar">

            <div>
                <h1 class="page-title">Quản lý sản phẩm</h1>
                <div class="page-subtitle">
                    Quản lý danh mục, sản phẩm và thực đơn MỘC BREW
                </div>
            </div>

            <div class="user-info">
                <i class="fa-solid fa-circle-user me-2"></i>
                <strong>@Session["MOCBREW_FullName"]</strong>
            </div>

        </div>

        <!-- STATISTICS -->
        <div class="row g-3">

            <div class="col-xl-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">Tổng sản phẩm đang kinh doanh</div>
                            <div class="stat-number">@Model.TotalActive</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-mug-hot"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">Sản phẩm đang ẩn</div>
                            <div class="stat-number">@Model.TotalInactive</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-eye-slash"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-title">Sản phẩm nổi bật</div>
                            <div class="stat-number">@Model.TotalFeatured</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-star"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        @if (TempData["ProductSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["ProductSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ProductError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                @TempData["ProductError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- PRODUCT LIST -->
        <div class="content-card">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h5 class="fw-bold mb-1">Danh sách sản phẩm</h5>
                    <div class="text-muted small">
                        Hiển thị @Model.Products.Count / @Model.TotalRecords sản phẩm phù hợp
                    </div>
                </div>

                <a href="@Url.Action("Create", "Products")"
                   class="btn-brown text-decoration-none">
                    <i class="fa-solid fa-plus me-2"></i>
                    Thêm sản phẩm
                </a>

            </div>

            <!-- SEARCH AND FILTER -->
            @using (Html.BeginForm("Index", "Products", FormMethod.Get))
            {
                <div class="row g-2 mb-4">

                    <div class="col-lg-5 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>

                            <input type="text"
                                   name="keyword"
                                   value="@Model.Keyword"
                                   class="form-control filter-input border-start-0"
                                   placeholder="Nhập tên sản phẩm cần tìm..." />
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4">
                        @Html.DropDownList(
                                      "categoryId",
                                      new SelectList(
                                          Model.Categories,
                                          "CategoryId",
                                          "CategoryName",
                                          Model.CategoryId),
                                      "-- Tất cả danh mục --",
                                      new { @class = "form-select filter-input" })
                    </div>

                    <div class="col-lg-3 col-md-2 d-flex gap-2">

                        <button type="submit" class="btn-brown flex-grow-1">
                            <i class="fa-solid fa-filter me-1"></i>
                            Lọc
                        </button>

                        <a href="@Url.Action("Index", "Products")"
                           class="btn-light-brown text-decoration-none d-flex align-items-center">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>

                    </div>

                </div>
            }

            <!-- TABLE -->
            <div class="table-responsive">

                <table class="table product-table">

                    <thead>
                        <tr>
                            <th style="width:65px;">Ảnh</th>
                            <th>Sản phẩm</th>
                            <th>Danh mục</th>
                            <th class="text-center">Size S</th>
                            <th class="text-center">Size M</th>
                            <th class="text-center">Size L</th>
                            <th>Trạng thái</th>
                            <th>Nổi bật</th>
                            <th style="width:100px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>


                        @if (Model.Products != null && Model.Products.Any())
                        {
                            foreach (var item in Model.Products)
                            {
                                <tr>

                                    <!-- ẢNH SẢN PHẨM -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@Url.Content(item.ImageUrl)"
                                                 class="product-image"
                                                 alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <div class="image-placeholder">
                                                <i class="fa-solid fa-mug-hot"></i>
                                            </div>
                                        }
                                    </td>

                                    <!-- TÊN SẢN PHẨM -->
                                    <td>
                                        <div class="product-name">
                                            @item.ProductName
                                        </div>

                                        <div class="category-text">
                                            Mã SP: #@item.ProductId
                                        </div>
                                    </td>

                                    <!-- DANH MỤC -->
                                    <td>@item.CategoryName</td>

                                    <!-- GIÁ SIZE S -->
                                    <td class="text-center">
                                        @if (item.PriceS.HasValue)
                                        {
                                            <strong class="price-size">
                                                @item.PriceS.Value.ToString("N0") đ
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="normal-label">—</span>
                                        }
                                    </td>

                                    <!-- GIÁ SIZE M -->
                                    <td class="text-center">
                                        @if (item.PriceM.HasValue)
                                        {
                                            <strong class="price-size">
                                                @item.PriceM.Value.ToString("N0") đ
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="normal-label">—</span>
                                        }
                                    </td>

                                    <!-- GIÁ SIZE L -->
                                    <td class="text-center">
                                        @if (item.PriceL.HasValue)
                                        {
                                            <strong class="price-size">
                                                @item.PriceL.Value.ToString("N0") đ
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="normal-label">—</span>
                                        }
                                    </td>

                                    <!-- TRẠNG THÁI -->
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-active">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">Đang ẩn</span>
                                        }
                                    </td>

                                    <!-- SẢN PHẨM NỔI BẬT -->
                                    <td>
                                        @if (item.IsFeatured)
                                        {
                                            <span class="featured">
                                                <i class="fa-solid fa-star me-1"></i>
                                                Nổi bật
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="normal-label">Thông thường</span>
                                        }
                                    </td>

                                    <!-- THAO TÁC -->
                                    <td>
                                        <a href="@Url.Action("Edit", "Products", new { id = item.ProductId })"
                                           class="btn-light-brown text-decoration-none"
                                           title="Sửa sản phẩm">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        @using (Html.BeginForm(
                                            "ToggleStatus",
                                            "Products",
                                            FormMethod.Post,
                                            new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            @Html.Hidden("id", item.ProductId)

                                            if (item.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn-light-brown"
                                                        title="Ngừng kinh doanh"
                                                        onclick="return confirm('Bạn có chắc chắn muốn ngừng kinh doanh sản phẩm này?');">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn-light-brown"
                                                        title="Mở bán lại"
                                                        onclick="return confirm('Bạn có chắc chắn muốn mở bán lại sản phẩm này?');">
                                                    <i class="fa-solid fa-rotate"></i>
                                                </button>
                                            }
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="empty-state">
                                        <i class="fa-solid fa-mug-saucer d-block"></i>
                                        <h6 class="fw-bold">Chưa tìm thấy sản phẩm</h6>
                                        <p class="small mb-0">
                                            Vui lòng thử từ khóa hoặc danh mục khác.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }


                    </tbody>

                </table>

            </div>

            <!-- PAGINATION -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

                    <div class="small text-muted">
                        Trang @Model.CurrentPage / @Model.TotalPages
                    </div>

                    <nav>
                        <ul class="pagination mb-0">

                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                           keyword = Model.Keyword,
                                           categoryId = Model.CategoryId,
                                           page = Model.CurrentPage - 1
                                       })">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                           keyword = Model.Keyword,
                                           categoryId = Model.CategoryId,
                                           page = i
                                       })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                           keyword = Model.Keyword,
                                           categoryId = Model.CategoryId,
                                           page = Model.CurrentPage + 1
                                       })">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </li>
                            }

                        </ul>
                    </nav>

                </div>
            }

        </div>

        <div class="text-center text-muted small mt-4">
            © @DateTime.Now.Year MỘC BREW - Coffee Management System
        </div>

    </main>

</body>
</html>
