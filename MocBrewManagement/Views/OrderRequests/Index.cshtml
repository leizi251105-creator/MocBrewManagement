
@model List<MocBrewManagement.ViewModels.OrderRequestListViewModel>

@{
    ViewBag.Title = "Quản lý yêu cầu hủy đơn / hoàn tiền";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Quản lý yêu cầu | MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f7f3ed;
            font-family: Arial, sans-serif;
            color: #3e3025;
        }

        .page-header {
            background: #4b3023;
            color: white;
            padding: 24px 30px;
        }

        .brand {
            font-size: 25px;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .container-main {
            max-width: 1450px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .page-title {
            font-size: 27px;
            font-weight: bold;
            color: #4b3023;
        }

        .request-card {
            background: white;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
        }

        .table th {
            background: #f0e8de;
            color: #4b3023;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .status {
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }

        .pending {
            background: #fff1cc;
            color: #9a6700;
        }

        .approved {
            background: #d9f2df;
            color: #176b35;
        }

        .rejected {
            background: #f8dddd;
            color: #a52828;
        }

        .btn-brown {
            background: #795238;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5c3b29;
                color: white;
            }

        .empty-state {
            padding: 45px;
            text-align: center;
            color: #8a8178;
        }
    </style>
</head>

<body>

    <header class="page-header">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="brand">
                <i class="fa-solid fa-mug-hot me-2"></i>
                MỘC BREW
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-light btn-sm">
                <i class="fa-solid fa-house me-1"></i>
                Trang chủ
            </a>
        </div>
    </header>

    <main class="container-main">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title">
                    <i class="fa-solid fa-file-circle-exclamation me-2"></i>
                    Quản lý yêu cầu hủy đơn / hoàn tiền
                </h2>

                <p class="text-muted mb-0">
                    Tiếp nhận và xử lý các yêu cầu do nhân viên và quản lý cửa hàng gửi lên.
                </p>
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>

        <div class="request-card">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Danh sách yêu cầu</h5>

                <span class="text-muted">
                    Tổng số: @Model.Count yêu cầu
                </span>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Mã yêu cầu</th>
                                <th>Mã đơn hàng</th>
                                <th>Loại yêu cầu</th>
                                <th>Người gửi</th>
                                <th>Lý do</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái đơn</th>
                                <th>Trạng thái yêu cầu</th>
                                <th>Thời gian gửi</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.RequestId</td>

                                    <td class="fw-bold">
                                        @item.OrderCode
                                    </td>

                                    <td>
                                        @if (item.RequestType == "Refund")
                                        {
                                            <span class="text-warning fw-bold">
                                                <i class="fa-solid fa-money-bill-transfer me-1"></i>
                                                Hoàn tiền
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold">
                                                <i class="fa-solid fa-ban me-1"></i>
                                                Hủy đơn
                                            </span>
                                        }
                                    </td>

                                    <td>@item.RequestedByName</td>

                                    <td style="min-width:150px;">
                                        @item.Reason
                                    </td>

                                    <td class="fw-bold">
                                        @item.TotalAmount.ToString("N0") đ
                                    </td>

                                    <td>@item.OrderStatus</td>

                                    <td>
                                        @if (item.RequestStatus == "Pending")
                                        {
                                            <span class="status pending">Chờ duyệt</span>
                                        }
                                        else if (item.RequestStatus == "Approved")
                                        {
                                            <span class="status approved">Đã duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="status rejected">Đã từ chối</span>
                                        }
                                    </td>

                                    <td>
                                        @item.RequestedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <a href="@Url.Action("Details", "OrderRequests", new { id = item.RequestId })"
                                           class="btn btn-sm btn-brown">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Xử lý
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-solid fa-inbox fa-3x mb-3"></i>
                    <h5>Chưa có yêu cầu nào</h5>
                    <p class="mb-0">
                        Các yêu cầu hủy đơn và hoàn tiền sẽ xuất hiện tại đây.
                    </p>
                </div>
            }

        </div>

    </main>

</body>
</html>
