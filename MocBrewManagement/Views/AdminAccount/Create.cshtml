
@model MocBrewManagement.Models.AdminAccountViewModel

@{
    Layout = null;
    ViewBag.Title = "Thêm Super Admin - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Roboto', sans-serif;
            background: #f7f4ef;
            color: #38271e;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #38271e;
            color: white;
            padding: 28px 18px;
            display: flex;
            flex-direction: column;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            text-align: center;
        }

        .brand-sub {
            text-align: center;
            color: #d6b99d;
            font-size: 12px;
            margin-bottom: 40px;
        }

        .menu-title {
            color: #bca18b;
            font-size: 11px;
            font-weight: bold;
            margin: 22px 12px 10px;
            text-transform: uppercase;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #eee2d7;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 8px;
            margin-bottom: 5px;
        }

            .menu-link:hover,
            .menu-link.active {
                background: #76523d;
                color: white;
            }

            .menu-link i {
                width: 20px;
            }

        .sidebar-logout {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid #76523d;
        }

        .logout {
            color: #f2c9b8;
            text-decoration: none;
            padding: 13px 14px;
            display: block;
        }

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            border-bottom: 1px solid #eee5dc;
        }

        .user-info {
            text-align: right;
        }

            .user-info strong {
                display: block;
                font-size: 14px;
            }

            .user-info span {
                color: #927965;
                font-size: 12px;
            }

        .content {
            padding: 32px;
        }

        .page-heading {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
        }

        .page-description {
            color: #927965;
            margin-bottom: 25px;
        }

        .form-card {
            background: white;
            border: 1px solid #eee5dc;
            border-radius: 12px;
            padding: 30px;
            max-width: 850px;
        }

        .form-label {
            font-weight: 600;
            font-size: 13px;
        }

        .form-control {
            padding: 11px 13px;
            border: 1px solid #e5d9ce;
            border-radius: 8px;
        }

            .form-control:focus {
                border-color: #946b4d;
                box-shadow: 0 0 0 0.2rem rgba(148,107,77,.12);
            }

        .btn-save {
            background: #795238;
            color: white;
            border: none;
            padding: 11px 22px;
            border-radius: 8px;
        }

            .btn-save:hover {
                background: #543824;
                color: white;
            }

        .btn-back {
            background: #eee5dc;
            color: #543824;
            padding: 11px 20px;
            border-radius: 8px;
            text-decoration: none;
        }

        .role-info {
            background: #f8f3ee;
            border: 1px solid #ead9c9;
            border-radius: 8px;
            padding: 15px;
            color: #795238;
            font-size: 13px;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main {
                margin-left: 0;
            }

            .content {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">

        <div class="brand">MỘC BREW</div>
        <div class="brand-sub">MANAGEMENT SYSTEM</div>

        <div class="menu-title">Quản lý hệ thống</div>

        <a href="@Url.Action("Index", "AdminAccount")"
           class="menu-link active">
            <i class="fa-solid fa-user-shield"></i>
            Quản lý Super Admin
        </a>

        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="fa-solid fa-house"></i>
            Trang chủ
        </a>

        <div class="sidebar-logout">
            <a href="@Url.Action("Logout", "MocBrewAuth")"
               class="logout">
                <i class="fa-solid fa-right-from-bracket me-2"></i>
                Đăng xuất
            </a>
        </div>

    </aside>

    <main class="main">

        <header class="topbar">
            <h5>Thêm Super Admin</h5>

            <div class="user-info">
                <strong>@ViewBag.FullName</strong>
                <span>Super Admin</span>
            </div>
        </header>

        <section class="content">

            <h2 class="page-heading">Tạo tài khoản Super Admin</h2>

            <p class="page-description">
                Nhập thông tin để tạo tài khoản quản trị cấp cao mới.
            </p>

            <div class="form-card">

                @using (Html.BeginForm("Create", "AdminAccount",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(false, "",
                             new { @class = "alert alert-danger" })

                    <div class="role-info mb-4">
                        <i class="fa-solid fa-shield-halved me-2"></i>
                        Vai trò được tự động thiết lập là
                        <strong>Super Admin</strong>.
                        Bạn không cần chọn vai trò.
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Họ và tên *</label>

                            @Html.TextBoxFor(m => m.FullName,
                                     new
                                     {
                                         @class = "form-control",
                                         placeholder = "Nhập họ và tên"
                                     })

                            @Html.ValidationMessageFor(m => m.FullName,
                                     "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Tên đăng nhập *</label>

                            @Html.TextBoxFor(m => m.Username,
                                     new
                                     {
                                         @class = "form-control",
                                         placeholder = "Nhập tên đăng nhập"
                                     })

                            @Html.ValidationMessageFor(m => m.Username,
                                     "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Mật khẩu *</label>

                            @Html.PasswordFor(m => m.Password,
                                     new
                                     {
                                         @class = "form-control",
                                         placeholder = "Ít nhất 6 ký tự"
                                     })

                            @Html.ValidationMessageFor(m => m.Password,
                                     "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>

                            @Html.TextBoxFor(m => m.Email,
                                     new
                                     {
                                         @class = "form-control",
                                         placeholder = "example@email.com",
                                         type = "email"
                                     })

                            @Html.ValidationMessageFor(m => m.Email,
                                     "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>

                            @Html.TextBoxFor(m => m.Phone,
                                     new
                                     {
                                         @class = "form-control",
                                         placeholder = "Nhập số điện thoại"
                                     })

                            @Html.ValidationMessageFor(m => m.Phone,
                                     "", new { @class = "text-danger small" })
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2 flex-wrap">

                        <button type="submit" class="btn-save">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Tạo tài khoản
                        </button>

                        <a href="@Url.Action("Index", "AdminAccount")"
                           class="btn-back">
                            Quay lại
                        </a>

                    </div>
                }

            </div>

        </section>

    </main>

</body>
</html>
