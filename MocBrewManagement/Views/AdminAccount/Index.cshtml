
@model IEnumerable<MocBrewManagement.Models.Account>

@{
    Layout = null;
    ViewBag.Title = "Quản lý Super Admin - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Roboto', sans-serif;
            background: #f7f4ef;
            color: #38271e;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #38271e;
            color: white;
            padding: 28px 18px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            text-align: center;
        }

        .brand-sub {
            text-align: center;
            color: #d6b99d;
            font-size: 12px;
            margin-bottom: 40px;
        }

        .menu-title {
            color: #bca18b;
            font-size: 11px;
            font-weight: bold;
            margin: 22px 12px 10px;
            text-transform: uppercase;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #eee2d7;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.2s;
        }

            .menu-link:hover,
            .menu-link.active {
                background: #76523d;
                color: white;
            }

            .menu-link i {
                width: 20px;
            }

        .sidebar-logout {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid #76523d;
        }

        .logout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #f2c9b8;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 8px;
        }

            .logout:hover {
                background: #76523d;
                color: white;
            }

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            border-bottom: 1px solid #eee5dc;
        }

            .topbar h5 {
                margin: 0;
                font-weight: 700;
            }

        .user-info {
            text-align: right;
        }

            .user-info strong {
                display: block;
                font-size: 14px;
            }

            .user-info span {
                color: #927965;
                font-size: 12px;
            }

        .content {
            padding: 32px;
        }

        .page-heading {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            margin-bottom: 8px;
        }

        .page-description {
            color: #927965;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border: 1px solid #eee5dc;
            border-radius: 12px;
            padding: 22px;
            height: 100%;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4e9df;
            color: #795238;
            border-radius: 10px;
            font-size: 19px;
            margin-bottom: 15px;
        }

        .stat-card h3 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .stat-card p {
            color: #927965;
            font-size: 13px;
            margin: 0;
        }

        .table-card {
            background: white;
            border: 1px solid #eee5dc;
            border-radius: 12px;
            padding: 24px;
            margin-top: 28px;
        }

        .table-title {
            font-weight: 700;
            margin-bottom: 20px;
        }

        .table thead th {
            background: #f8f3ee;
            color: #795238;
            font-size: 13px;
            white-space: nowrap;
            padding: 14px;
        }

        .table tbody td {
            padding: 15px 14px;
            vertical-align: middle;
            font-size: 13px;
        }

        .account-avatar {
            width: 38px;
            height: 38px;
            background: #f4e9df;
            color: #795238;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }

        .status-active {
            background: #e5f3e9;
            color: #287344;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .status-locked {
            background: #fbe9e7;
            color: #b13d32;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .btn-create {
            background: #795238;
            color: white;
            padding: 11px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
        }

            .btn-create:hover {
                background: #543824;
                color: white;
            }

        .empty-state {
            text-align: center;
            padding: 35px;
            color: #927965;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main {
                margin-left: 0;
            }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 0 18px;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">MỘC BREW</div>

        <div class="brand-sub">MANAGEMENT SYSTEM</div>

        <div class="menu-title">Tổng quan</div>

        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="fa-solid fa-house"></i>
            Trang chủ
        </a>

        <div class="menu-title">Quản lý hệ thống</div>
        <a href="@Url.Action("Index", "AdminAccount")"
           class="menu-link active">
            <i class="fa-solid fa-user-shield"></i>
            Quản lý Super Admin
        </a>

        <a href="@Url.Action("Index", "SystemLog")" class="menu-link">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Nhật ký hoạt động
        </a>

        <a href="@Url.Action("Index", "Staff")" class="menu-link">
            <i class="fa-solid fa-users"></i>
            Nhân viên và phân quyền
        </a>

        <div class="sidebar-logout">
            <a href="@Url.Action("Logout", "MocBrewAuth")"
               class="logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                Đăng xuất
            </a>
        </div>

    </aside>

    <!-- MAIN -->
    <main class="main">

        <header class="topbar">

            <h5>Quản lý Super Admin</h5>

            <div class="user-info">
                <strong>@ViewBag.FullName</strong>
                <span>Super Admin</span>
            </div>

        </header>

        <section class="content">

            <h2 class="page-heading">Quản lý tài khoản Super Admin</h2>

            <p class="page-description">
                Quản lý các tài khoản có quyền quản trị cấp cao của hệ thống MỘC BREW.
            </p>

            <!-- THỐNG KÊ -->
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <h3>@ViewBag.TotalAccounts</h3>
                        <p>Tổng số Super Admin</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-user-check"></i>
                        </div>

                        <h3>@ViewBag.ActiveAccounts</h3>
                        <p>Tài khoản đang hoạt động</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fa-solid fa-user-lock"></i>
                        </div>

                        <h3>@ViewBag.LockedAccounts</h3>
                        <p>Tài khoản bị khóa</p>
                    </div>
                </div>

            </div>

            <!-- DANH SÁCH -->
            <div class="table-card">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">

                    <h5 class="table-title mb-0">
                        Danh sách Super Admin
                    </h5>

                    <a href="@Url.Action("Create", "AdminAccount")"
                       class="btn-create">
                        <i class="fa-solid fa-plus me-2"></i>
                        Thêm Super Admin
                    </a>

                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close"
                                data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close"
                                data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Thông tin tài khoản</th>
                                <th>Tên đăng nhập</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>


                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;

                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@stt</td>

                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="account-avatar">
                                                    <i class="fa-solid fa-user-shield"></i>
                                                </div>

                                                <strong>@item.FullName</strong>
                                            </div>
                                        </td>

                                        <td>@item.Username</td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Email)
                    ? "Chưa cập nhật"
                    : item.Email)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Phone)
                    ? "Chưa cập nhật"
                    : item.Phone)
                                        </td>

                                        <td>Super Admin</td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-active">
                                                    Đang hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-locked">
                                                    Đã khóa
                                                </span>
                                            }
                                        </td>

                                        @* NÚT CHỈNH SỬA TÀI KHOẢN *@

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">

                                                @* Nút chỉnh sửa *@
                                                <a href="@Url.Action("Edit", "AdminAccount", new { id = item.AccountId })"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Chỉnh sửa tài khoản">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                    Sửa
                                                </a>

                                                @* Nút khóa hoặc mở khóa *@
                                                @using (Html.BeginForm("ToggleStatus", "AdminAccount",
                                                    FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    @Html.Hidden("id", item.AccountId)

                                                    if (item.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này không?');">
                                                            <i class="fa-solid fa-lock"></i>
                                                            Khóa
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-success"
                                                                onclick="return confirm('Bạn có chắc chắn muốn mở khóa tài khoản này không?');">
                                                            <i class="fa-solid fa-lock-open"></i>
                                                            Mở khóa
                                                        </button>
                                                    }
                                                }

                                            </div>
                                        </td>

                                    </tr>

                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="fa-solid fa-users-slash fa-2x mb-3"></i>
                                            <p>Chưa có tài khoản Super Admin.</p>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</body>
</html>
