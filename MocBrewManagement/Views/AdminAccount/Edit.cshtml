
@model MocBrewManagement.Models.AdminAccountEditViewModel

@{
    Layout = null;
    ViewBag.Title = "Chỉnh sửa Super Admin - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f7f4ef;
            color: #38271e;
            font-family: 'Roboto', sans-serif;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #38271e;
            color: white;
            padding: 28px 18px;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 35px;
        }

        .menu-link {
            display: block;
            color: #eadfd5;
            text-decoration: none;
            padding: 13px 15px;
            border-radius: 9px;
            margin-bottom: 8px;
        }

            .menu-link:hover,
            .menu-link.active {
                background: #79533d;
                color: white;
            }

            .menu-link i {
                width: 25px;
            }

        .main {
            margin-left: 250px;
            padding: 30px 40px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }

        .form-card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(56,39,30,.06);
            max-width: 850px;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-control {
            padding: 12px;
            border-radius: 9px;
        }

        .btn-brown {
            background: #79533d;
            color: white;
            border: none;
            padding: 11px 22px;
            border-radius: 9px;
        }

            .btn-brown:hover {
                background: #38271e;
                color: white;
            }

        .btn-back {
            background: #eee8e2;
            color: #38271e;
            padding: 11px 22px;
            border-radius: 9px;
            text-decoration: none;
        }

            .btn-back:hover {
                background: #dfd3c8;
                color: #38271e;
            }

        .help-text {
            color: #82756c;
            font-size: 13px;
            margin-top: 6px;
        }

        @@media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <aside class="sidebar">
        <div class="brand">MỘC BREW</div>

        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="fa-solid fa-house"></i> Trang chủ
        </a>

        <a href="@Url.Action("Index", "AdminAccount")" class="menu-link active">
            <i class="fa-solid fa-user-shield"></i> Quản lý Super Admin
        </a>

        <a href="@Url.Action("Index", "Staff")" class="menu-link">
            <i class="fa-solid fa-users"></i> Quản lý nhân viên
        </a>

        <a href="@Url.Action("Logout", "MocBrewAuth")" class="menu-link">
            <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </a>
    </aside>

    <main class="main">
        <div class="topbar">
            <div>
                <h3 class="page-title mb-1">Chỉnh sửa tài khoản</h3>
                <div class="text-muted">Quản lý thông tin Super Admin</div>
            </div>

            <div>
                <i class="fa-solid fa-user-shield me-2"></i>
                @(ViewBag.FullName ?? "Super Admin")
            </div>
        </div>

        <div class="form-card">
            <div class="mb-4">
                <h5 class="fw-bold">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Thông tin tài khoản
                </h5>
                <p class="text-muted mb-0">
                    Cập nhật thông tin tài khoản Super Admin.
                </p>
            </div>

            @using (Html.BeginForm("Edit", "AdminAccount", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.AccountId)

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FullName, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập họ và tên"
                        })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Username, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập tên đăng nhập"
                        })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            placeholder = "example@email.com"
                        })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Phone, "Số điện thoại", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Phone, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập số điện thoại"
                        })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12 mb-4">
                        @Html.LabelFor(m => m.NewPassword, "Mật khẩu mới", new { @class = "form-label" })
                        @Html.PasswordFor(m => m.NewPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Để trống nếu không muốn đổi mật khẩu"
                        })
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })

                        <div class="help-text">
                            Không bắt buộc. Nếu để trống, mật khẩu hiện tại sẽ được giữ nguyên.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-brown">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu thay đổi
                    </button>

                    <a href="@Url.Action("Index", "AdminAccount")" class="btn-back">
                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Quay lại
                    </a>
                </div>
            }
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
