
@model MocBrewManagement.ViewModels.ProfitReportViewModel

@{
    Layout = null;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Báo cáo giá vốn và lợi nhuận - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f3ef;
            color: #3b3028;
            font-family: Arial, sans-serif;
        }

        .page {
            max-width: 1450px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .header, .report-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 18px rgba(0,0,0,.05);
            margin-bottom: 22px;
        }

        .brand {
            color: #765039;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 4px 18px rgba(0,0,0,.04);
            border-left: 4px solid #96704f;
        }

        .stat-label {
            color: #82776e;
            font-size: 14px;
        }

        .stat-value {
            font-size: 25px;
            font-weight: 800;
            margin-top: 10px;
        }

        .table thead th {
            background: #eee8e1;
            color: #5a4030;
            white-space: nowrap;
        }

        .profit-positive {
            color: #198754;
            font-weight: 700;
        }

        .profit-negative {
            color: #dc3545;
            font-weight: 700;
        }

        .section-title {
            font-weight: 800;
            color: #60432f;
            margin-bottom: 18px;
        }

        .btn-brown {
            background: #765039;
            color: white;
        }

            .btn-brown:hover {
                background: #5d3d2b;
                color: white;
            }
    </style>
</head>

<body>
    <div class="page">

        <div class="header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="brand">MỘC BREW</div>
                    <h3 class="fw-bold mt-2 mb-1">
                        <i class="fa-solid fa-chart-line me-2"></i>
                        Báo cáo giá vốn và lợi nhuận
                    </h3>
                    <div class="text-muted">
                        Phân tích doanh thu, chi phí nguyên liệu và lợi nhuận gộp
                    </div>
                </div>

                <a href="@Url.Action("Index", "Reports")"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Quay lại báo cáo
                </a>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="report-card">
            <form method="get" action="@Url.Action("Profit", "Reports")"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Từ ngày</label>
                    <input type="date" name="fromDate"
                           class="form-control"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Đến ngày</label>
                    <input type="date" name="toDate"
                           class="form-control"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-brown w-100">
                        <i class="fa-solid fa-filter me-2"></i>
                        Xem báo cáo
                    </button>
                </div>
            </form>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-label">Doanh thu sản phẩm</div>
                    <div class="stat-value text-primary">
                        @Model.TotalRevenue.ToString("N0", vi) đ
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-label">Giá vốn nguyên liệu</div>
                    <div class="stat-value text-warning">
                        @Model.TotalCost.ToString("N0", vi) đ
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-label">Lợi nhuận gộp</div>
                    <div class="stat-value @(Model.GrossProfit >= 0 ? "text-success" : "text-danger")">
                        @Model.GrossProfit.ToString("N0", vi) đ
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-label">Tỷ suất lợi nhuận gộp</div>
                    <div class="stat-value">
                        @Model.GrossMargin.ToString("N2", vi)%
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="report-card mb-0">
                    <div class="text-muted">Tổng đơn hàng trong kỳ</div>
                    <h4 class="fw-bold mt-2">@Model.TotalOrders</h4>
                </div>
            </div>

            <div class="col-md-4">
                <div class="report-card mb-0">
                    <div class="text-muted">Đơn hàng hoàn thành</div>
                    <h4 class="fw-bold mt-2 text-success">@Model.CompletedOrders</h4>
                </div>
            </div>

            <div class="col-md-4">
                <div class="report-card mb-0">
                    <div class="text-muted">Đơn hàng đã hoàn tiền</div>
                    <h4 class="fw-bold mt-2 text-danger">@Model.RefundedOrders</h4>
                </div>
            </div>
        </div>

        <div class="report-card">
            <h5 class="section-title">
                <i class="fa-solid fa-mug-hot me-2"></i>
                Lợi nhuận theo sản phẩm
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Sản phẩm</th>
                            <th>Size</th>
                            <th class="text-end">Số lượng bán</th>
                            <th class="text-end">Doanh thu</th>
                            <th class="text-end">Giá vốn</th>
                            <th class="text-end">Lợi nhuận</th>
                            <th class="text-end">Tỷ suất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProductProfits != null && Model.ProductProfits.Any())
                        {
                            var index = 1;

                            foreach (var item in Model.ProductProfits)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td>@item.SizeName</td>
                                    <td class="text-end">@item.TotalQuantity</td>
                                    <td class="text-end">@item.Revenue.ToString("N0", vi) đ</td>
                                    <td class="text-end">@item.Cost.ToString("N0", vi) đ</td>
                                    <td class="text-end @(item.Profit >= 0 ? "profit-positive" : "profit-negative")">
                                        @item.Profit.ToString("N0", vi) đ
                                    </td>
                                    <td class="text-end">@item.ProfitMargin.ToString("N2", vi)%</td>
                                </tr>

                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Chưa có dữ liệu bán hàng hoàn thành trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="report-card">
            <h5 class="section-title">
                <i class="fa-solid fa-calendar-days me-2"></i>
                Lợi nhuận theo ngày
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th class="text-end">Doanh thu</th>
                            <th class="text-end">Giá vốn</th>
                            <th class="text-end">Lợi nhuận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DailyProfits != null && Model.DailyProfits.Any())
                        {
                            foreach (var item in Model.DailyProfits)
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@item.Revenue.ToString("N0", vi) đ</td>
                                    <td class="text-end">@item.Cost.ToString("N0", vi) đ</td>
                                    <td class="text-end @(item.Profit >= 0 ? "profit-positive" : "profit-negative")">
                                        @item.Profit.ToString("N0", vi) đ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Chưa có dữ liệu.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fa-solid fa-circle-info me-2"></i>
            Báo cáo sử dụng giá nhập bình quân hiện tại và công thức pha chế đang hoạt động.
            Chưa bao gồm giá vốn topping, bao bì chưa có trong công thức, nhân công,
            điện nước và các chi phí vận hành khác. Đây là báo cáo lợi nhuận gộp ước tính,
            không phải lợi nhuận ròng hoặc giá vốn lịch sử tại ngày bán.
        </div>

        <div class="text-center text-muted small mb-4">
            © MỘC BREW - Báo cáo quản lý kinh doanh
        </div>

    </div>
</body>
</html>
