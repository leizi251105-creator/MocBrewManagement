
@{
    ViewBag.Title = "Báo cáo thống kê";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Báo cáo thống kê - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6f8;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .header {
            background: #fff;
            padding: 22px 30px;
            border-bottom: 1px solid #eee;
        }

        .brand {
            color: #654321;
            font-size: 23px;
            font-weight: 700;
        }

        .report-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            height: 100%;
            border: 1px solid #eee;
            transition: .2s;
        }

            .report-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(0,0,0,.08);
            }

        .report-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #f5eee6;
            color: #79532d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-bottom: 18px;
        }

        .report-card h5 {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .report-card p {
            color: #777;
            min-height: 45px;
        }

        .report-link {
            text-decoration: none;
            color: inherit;
            display: block;
            height: 100%;
        }

        .btn-back {
            color: #654321;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="header">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="brand">
                <i class="fa-solid fa-mug-hot"></i>
                MỘC BREW
            </div>

            <a href="@Url.Action("Index", "Home")" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại trang chủ
            </a>
        </div>
    </div>

    <div class="container-fluid px-4 py-4">
        <div class="mb-4">
            <h3 class="fw-bold">Báo cáo thống kê</h3>
            <p class="text-muted">
                Theo dõi tình hình hoạt động và hiệu quả kinh doanh của cửa hàng.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-6 col-xl-3">
                <a href="@Url.Action("Shift", "Reports")" class="report-link">
                    <div class="report-card">
                        <div class="report-icon">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                        <h5>Báo cáo ca làm</h5>
                        <p>
                            Theo dõi hoạt động bán hàng và kết quả làm việc theo ca.
                        </p>
                        <span class="text-primary fw-semibold">
                            Xem báo cáo <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-lg-6 col-xl-3">
                <a href="@Url.Action("Revenue", "Reports")" class="report-link">
                    <div class="report-card">
                        <div class="report-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <h5>Báo cáo doanh thu</h5>
                        <p>
                            Tổng hợp doanh thu, đơn hàng và sản phẩm bán chạy.
                        </p>
                        <span class="text-primary fw-semibold">
                            Xem báo cáo <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-lg-6 col-xl-3">
                <a href="@Url.Action("Profit", "Reports")" class="report-link">
                    <div class="report-card">
                        <div class="report-icon">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                        <h5>Báo cáo lợi nhuận</h5>
                        <p>
                            Theo dõi doanh thu, chi phí nguyên liệu và lợi nhuận.
                        </p>
                        <span class="text-primary fw-semibold">
                            Xem báo cáo <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-lg-6 col-xl-3">
                <a href="@Url.Action("Inventory", "Reports")" class="report-link">
                    <div class="report-card">
                        <div class="report-icon">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <h5>Báo cáo tồn kho</h5>
                        <p>
                            Theo dõi số lượng tồn, nguyên liệu sắp hết và biến động kho.
                        </p>
                        <span class="text-primary fw-semibold">
                            Xem báo cáo <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

        </div>
    </div>
</body>
</html>
