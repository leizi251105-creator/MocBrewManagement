
@model MocBrewManagement.ViewModels.RevenueReportViewModel

@{
    ViewBag.Title = "Báo cáo doanh thu";
    Layout = null;
    var viCulture = new System.Globalization.CultureInfo("vi-VN");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Báo cáo doanh thu - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f3ef;
            font-family: Arial, sans-serif;
            color: #35291f;
        }

        .page {
            max-width: 1450px;
            margin: auto;
            padding: 30px;
        }

        .header {
            background: #49352a;
            color: white;
            padding: 25px 30px;
            border-radius: 15px;
            margin-bottom: 25px;
        }

            .header h2 {
                font-weight: 700;
                margin-bottom: 8px;
            }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 23px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
            border: 1px solid #eee7df;
        }

        .stat-title {
            color: #82776e;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 25px;
            font-weight: 700;
            color: #49352a;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            background: #f1e9e2;
            color: #805c43;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .content-card {
            background: white;
            border-radius: 14px;
            padding: 24px;
            margin-top: 25px;
            border: 1px solid #eee7df;
            box-shadow: 0 3px 12px rgba(0,0,0,.03);
        }

            .content-card h5 {
                font-weight: 700;
                margin-bottom: 20px;
            }

        .btn-moc {
            background: #49352a;
            color: white;
            border: none;
        }

            .btn-moc:hover {
                background: #624a3b;
                color: white;
            }

        .table thead th {
            background: #f4eee8;
            color: #49352a;
            white-space: nowrap;
        }

        .filter-box {
            background: white;
            border-radius: 14px;
            padding: 22px;
            border: 1px solid #eee7df;
        }

        .money {
            font-weight: 700;
            color: #49352a;
            white-space: nowrap;
        }
    </style>
</head>

<body>
    <div class="page">

        <div class="header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2><i class="fa-solid fa-chart-line me-2"></i>BÁO CÁO DOANH THU</h2>
                    <div>Theo dõi tình hình kinh doanh cửa hàng MỘC BREW</div>
                </div>

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-light">
                    <i class="fa-solid fa-house me-2"></i>Về Dashboard
                </a>
            </div>
        </div>

        @using (Html.BeginForm("Revenue", "Reports", FormMethod.Get))
        {
            <div class="filter-box">
                <h5 class="mb-3">
                    <i class="fa-solid fa-filter me-2"></i>Lọc thời gian báo cáo
                </h5>

                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Từ ngày</label>
                        <input type="date"
                               name="fromDate"
                               class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Đến ngày</label>
                        <input type="date"
                               name="toDate"
                               class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-4">
                        <button type="submit" class="btn btn-moc px-4">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>
                            Xem báo cáo
                        </button>

                        <a href="@Url.Action("Revenue", "Reports")"
                           class="btn btn-outline-secondary ms-2">
                            Làm mới
                        </a>
                    </div>
                </div>
            </div>
        }

        @Html.ValidationSummary(false, "", new { @class = "text-danger mt-3" })

        <div class="row g-3 mt-2">

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-title">Tổng doanh thu</div>
                            <div class="stat-value">
                                @Model.TotalRevenue.ToString("N0", viCulture) đ
                            </div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-title">Tổng đơn hàng</div>
                            <div class="stat-value">@Model.TotalOrders</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-title">Đơn hoàn thành</div>
                            <div class="stat-value">@Model.CompletedOrders</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="stat-title">Đơn đã hủy</div>
                            <div class="stat-value">@Model.CancelledOrders</div>
                        </div>
                        <div class="stat-icon">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-3 mt-1">

            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-title">Doanh thu bán tại quầy POS</div>
                    <div class="stat-value">
                        @Model.POSRevenue.ToString("N0", viCulture) đ
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="stat-card">
                    <div class="stat-title">Doanh thu bán Online</div>
                    <div class="stat-value">
                        @Model.OnlineRevenue.ToString("N0", viCulture) đ
                    </div>
                </div>
            </div>

        </div>

        <div class="content-card">
            <h5>
                <i class="fa-solid fa-calendar-days me-2"></i>
                Doanh thu theo ngày
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Ngày</th>
                            <th>Số đơn hoàn thành</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.DailyRevenues != null &&
                             Model.DailyRevenues.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model.DailyRevenues)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>@item.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TotalOrders</td>
                                    <td class="money">
                                        @item.Revenue.ToString("N0", viCulture) đ
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Không có dữ liệu doanh thu trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="content-card">
            <h5>
                <i class="fa-solid fa-mug-hot me-2"></i>
                TOP 10 SẢN PHẨM BÁN CHẠY
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Tên sản phẩm</th>
                            <th>Kích thước</th>
                            <th>Số lượng bán</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.TopProducts != null &&
                             Model.TopProducts.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model.TopProducts)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td>@item.ProductName</td>
                                    <td>@item.SizeName</td>
                                    <td>@item.TotalQuantity</td>
                                    <td class="money">
                                        @item.TotalRevenue.ToString("N0", viCulture) đ
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Chưa có dữ liệu sản phẩm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="content-card">
            <h5>
                <i class="fa-solid fa-circle-info me-2"></i>
                Ghi chú nghiệp vụ
            </h5>

            <ul class="mb-0">
                <li>Chỉ đơn hàng đã hoàn thành mới được tính doanh thu.</li>
                <li>Đơn hàng đã hủy không được tính vào doanh thu.</li>
                <li>Đơn hàng đã hoàn tiền không được tính vào doanh thu.</li>
                <li>Báo cáo phân biệt doanh thu POS và Online.</li>
            </ul>
        </div>

        <div class="text-center text-muted mt-4">
            MỘC BREW - HỆ THỐNG QUẢN LÝ CỬA HÀNG
        </div>

    </div>
</body>
</html>
