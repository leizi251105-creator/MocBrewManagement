
@model IEnumerable<MocBrewManagement.Models.Category>

@{
    Layout = null;
    ViewBag.Title = "Quản lý danh mục - MỘC BREW";

    var parents = Model
        .Where(c => c.ParentCategoryId == null)
        .OrderBy(c => c.CategoryId)
        .ToList();

    int totalParents = parents.Count;
    int totalChildren = Model.Count(c => c.ParentCategoryId != null);
    int totalActive = Model.Count(c => c.IsActive);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f7f5f1;
            font-family: Arial, sans-serif;
            color: #382b23;
        }

        .main {
            padding: 35px;
            max-width: 1200px;
            margin: auto;
        }

        .page-title {
            font-size: 27px;
            font-weight: 700;
            color: #513629;
        }

        .subtitle {
            color: #89796e;
            margin-top: 5px;
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 3px 15px rgba(60,40,20,.05);
            height: 100%;
        }

        .stat-number {
            font-size: 27px;
            font-weight: 700;
            color: #704b35;
        }

        .category-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 3px 15px rgba(60,40,20,.05);
        }

        .parent-name {
            font-size: 17px;
            font-weight: 700;
            color: #513629;
        }

        .child-list {
            margin-top: 15px;
            padding-left: 20px;
        }

        .child-item {
            border-top: 1px solid #eee8e2;
            padding: 12px 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .child-name {
            color: #65564c;
        }

        .btn-brown {
            background: #704b35;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px 16px;
            text-decoration: none;
        }

            .btn-brown:hover {
                background: #513629;
                color: white;
            }

        .status-active {
            color: #198754;
            background: #e8f5ed;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .status-inactive {
            color: #b02a37;
            background: #fbe9eb;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        @@media(max-width: 768px) {
            .main {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
    <div class="main">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <div class="page-title">
                    <i class="fa-solid fa-layer-group me-2"></i>
                    Quản lý danh mục
                </div>
                <div class="subtitle">
                    Quản lý danh mục sản phẩm theo cấu trúc cha - con
                </div>
            </div>

            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Trang quản trị
                </a>

                <a href="@Url.Action("Create", "Categories")"
                   class="btn-brown">
                    <i class="fa-solid fa-plus me-2"></i>
                    Thêm danh mục
                </a>
            </div>
        </div>

        @if (TempData["CategorySuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["CategorySuccess"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }
        @if (TempData["CategoryError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["CategoryError"]

                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Danh mục cha</div>
                    <div class="stat-number">@totalParents</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Danh mục con</div>
                    <div class="stat-number">@totalChildren</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Đang hoạt động</div>
                    <div class="stat-number">@totalActive</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Cây danh mục sản phẩm</h5>
            <span class="text-secondary small">
                @Model.Count() danh mục
            </span>
        </div>

        @foreach (var parent in parents)
        {
            <div class="category-card">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="parent-name">
                        <i class="fa-solid fa-folder-open me-2 text-warning"></i>
                        @parent.CategoryName
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (parent.IsActive)
                        {
                            <span class="status-active">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="status-inactive">Ngừng hoạt động</span>
                        }

                        <span class="text-secondary small">
                            @parent.Categories1.Count danh mục con
                        </span>

                        <a href="@Url.Action("Edit", "Categories", new { id = parent.CategoryId })"
                           class="btn btn-sm btn-outline-warning"
                           title="Chỉnh sửa danh mục">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>

                        @using (Html.BeginForm("ToggleStatus", "Categories",
                            new { id = parent.CategoryId }, FormMethod.Post,
                            new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm @(parent.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                    title="@(parent.IsActive ? "Ngừng hoạt động" : "Kích hoạt")">
                                <i class="fa-solid @(parent.IsActive ? "fa-ban" : "fa-check")"></i>
                            </button>
                        }
                    </div>
                </div>

                <div class="child-list">
                    @foreach (var child in parent.Categories1.OrderBy(c => c.CategoryId))
                    {
                        <div class="child-item">
                            <div class="child-name">
                                <i class="fa-solid fa-folder me-2 text-secondary"></i>
                                @child.CategoryName
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (child.IsActive)
                                {
                                    <span class="status-active">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-inactive">Ngừng hoạt động</span>
                                }

                                <a href="@Url.Action("Edit", "Categories", new { id = child.CategoryId })"
                                   class="btn btn-sm btn-outline-warning"
                                   title="Chỉnh sửa danh mục">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                @using (Html.BeginForm("ToggleStatus", "Categories",
                                    new { id = child.CategoryId }, FormMethod.Post,
                                    new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm @(child.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(child.IsActive ? "Ngừng hoạt động" : "Kích hoạt")">
                                        <i class="fa-solid @(child.IsActive ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>
        }

    </div>
</body>
</html>
