
@model MocBrewManagement.Models.CategoryEditViewModel

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Chỉnh sửa danh mục - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            background: #f7f3ed;
            font-family: Arial, sans-serif;
            color: #493629;
        }

        .page-wrapper {
            max-width: 850px;
            margin: 40px auto;
            padding: 0 18px;
        }

        .form-card {
            background: white;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 4px 18px rgba(70, 48, 30, .07);
        }

        .page-title {
            color: #60442f;
            font-weight: 700;
            margin: 18px 0 8px;
        }

        .section-title {
            font-size: 17px;
            font-weight: 700;
            color: #704d34;
            border-bottom: 1px solid #eee5da;
            padding-bottom: 12px;
            margin: 25px 0 20px;
        }

        .form-label {
            font-weight: 600;
            color: #594332;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 10px 12px;
            border-color: #dfd4c8;
        }

            .form-control:focus, .form-select:focus {
                border-color: #98704d;
                box-shadow: 0 0 0 .2rem rgba(152, 112, 77, .12);
            }

        .btn-brown {
            background: #704d34;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 11px 22px;
        }

            .btn-brown:hover {
                background: #553923;
                color: white;
            }

        .btn-cancel {
            background: #eee8e1;
            color: #60442f;
            border-radius: 8px;
            padding: 11px 22px;
            text-decoration: none;
        }

            .btn-cancel:hover {
                background: #e2d7ca;
                color: #60442f;
            }
    </style>
</head>

<body>
    <div class="page-wrapper">

        <a href="@Url.Action("Index", "Categories")"
           class="text-decoration-none text-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại danh sách danh mục
        </a>

        <h2 class="page-title">
            <i class="fa-solid fa-pen-to-square"></i>
            Chỉnh sửa danh mục
        </h2>

        <p class="text-muted mb-4">
            Cập nhật thông tin danh mục sản phẩm MỘC BREW.
        </p>

        <div class="form-card">

            @using (Html.BeginForm(
                "Edit",
                "Categories",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.CategoryId)

                @Html.ValidationSummary(
                         false,
                         "",
                         new { @class = "alert alert-danger" })

                <div class="section-title">
                    <i class="fa-solid fa-layer-group"></i>
                    Thông tin danh mục
                </div>

                <div class="mb-3">
                    @Html.LabelFor(
                             m => m.CategoryName,
                             "Tên danh mục",
                             new { @class = "form-label" })

                    @Html.TextBoxFor(
                             m => m.CategoryName,
                             new
                             {
                                 @class = "form-control",
                                 placeholder = "Nhập tên danh mục"
                             })

                    @Html.ValidationMessageFor(
                             m => m.CategoryName,
                             "",
                             new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Danh mục cha
                    </label>

                    @Html.DropDownListFor(
                             m => m.ParentCategoryId,
                             Model.ParentCategories,
                             "-- Đây là danh mục cha --",
                             new { @class = "form-select" })

                    @Html.ValidationMessageFor(
                             m => m.ParentCategoryId,
                             "",
                             new { @class = "text-danger" })

                    <small class="text-muted">
                        Nếu chọn một danh mục cha, danh mục hiện tại
                        sẽ trở thành danh mục con.
                    </small>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(
                             m => m.Description,
                             "Mô tả",
                             new { @class = "form-label" })

                    @Html.TextAreaFor(
                             m => m.Description,
                             new
                             {
                                 @class = "form-control",
                                 rows = "4",
                                 placeholder = "Nhập mô tả danh mục..."
                             })

                    @Html.ValidationMessageFor(
                             m => m.Description,
                             "",
                             new { @class = "text-danger" })
                </div>

                <div class="section-title">
                    <i class="fa-solid fa-toggle-on"></i>
                    Trạng thái danh mục
                </div>

                <div class="form-check mb-4">
                    @Html.CheckBoxFor(
                             m => m.IsActive,
                             new { @class = "form-check-input" })

                    <label class="form-check-label">
                        Đang hoạt động
                    </label>

                    @Html.ValidationMessageFor(
                             m => m.IsActive,
                             "",
                             new { @class = "text-danger" })
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="@Url.Action("Index", "Categories")"
                       class="btn-cancel">
                        Hủy
                    </a>

                    <button type="submit" class="btn-brown">B
                        <i class="fa-solid fa-floppy-disk"></i>
                        Lưu thay đổi
                    </button>
                </div>
            }
        </div>
    </div>
</body>
</html>
