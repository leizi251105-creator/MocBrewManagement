
@model MocBrewManagement.ViewModels.SupplierIngredientViewModel

@{
    ViewBag.Title = "Thiết lập nguyên liệu nhà cung cấp";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Thiết lập nguyên liệu - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f6f8;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .page {
            max-width: 1100px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .header {
            background: #fff;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 22px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }

        .supplier-name {
            color: #795548;
            font-weight: 700;
        }

        .content-card {
            background: #fff;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }

        .ingredient-row {
            padding: 13px 15px;
            border-bottom: 1px solid #eee;
        }

            .ingredient-row:hover {
                background: #faf8f5;
            }

        .btn-brown {
            background: #795548;
            color: #fff;
            border: none;
        }

            .btn-brown:hover {
                background: #5d4037;
                color: #fff;
            }

        .ingredient-name {
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="page">

        <div class="header">

            <a href="@Url.Action("Index", "Suppliers")"
               class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại nhà cung cấp
            </a>

            <h3 class="fw-bold">
                <i class="fa-solid fa-boxes-stacked text-warning"></i>
                Thiết lập nguyên liệu
            </h3>

            <div class="supplier-name fs-5 mt-2">
                @Model.SupplierName
            </div>

            <div class="text-muted mt-1">
                Chọn những nguyên liệu mà nhà cung cấp này có thể cung cấp.
            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="content-card">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">

                <div>
                    <h5 class="fw-bold mb-1">Danh sách nguyên liệu</h5>
                    <div class="text-muted small">
                        Đánh dấu vào nguyên liệu được nhà cung cấp cung cấp.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-success btn-sm"
                            onclick="selectAll()">
                        <i class="fa-solid fa-check-double"></i>
                        Chọn tất cả
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            onclick="unselectAll()">
                        Bỏ chọn tất cả
                    </button>
                </div>

            </div>

            <input type="text"
                   id="searchIngredient"
                   class="form-control mb-3"
                   placeholder="Tìm kiếm nguyên liệu..." />

            <form method="post"
                  action="@Url.Action("Save", "SupplierIngredients")">

                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.SupplierId)

                <div class="row fw-bold text-muted small px-3 py-2 border-bottom">
                    <div class="col-2 col-md-1">Chọn</div>
                    <div class="col-7 col-md-7">Tên nguyên liệu</div>
                    <div class="col-3 col-md-4">Đơn vị</div>
                </div>

                @for (int i = 0; i < Model.Ingredients.Count; i++)
                {
                    <div class="row align-items-center ingredient-row ingredient-item">

                        <div class="col-2 col-md-1">

                            @Html.HiddenFor(m => m.Ingredients[i].IngredientId)

                            @Html.CheckBoxFor(
                                     m => m.Ingredients[i].IsSelected,
                                     new { @class = "form-check-input ingredient-checkbox" })

                        </div>

                        <div class="col-7 col-md-7 ingredient-name">
                            @Model.Ingredients[i].IngredientName
                        </div>

                        <div class="col-3 col-md-4 text-muted">
                            @Model.Ingredients[i].Unit
                        </div>

                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <a href="@Url.Action("Index", "Suppliers")"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>

                    <button type="submit" class="btn btn-brown px-4">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Lưu thiết lập
                    </button>

                </div>

            </form>

        </div>

    </div>

    <script>function selectAll() {
        document.querySelectorAll(".ingredient-item:not(.d-none) .ingredient-checkbox")
            .forEach(x => x.checked = true);
    }

    function unselectAll() {
        document.querySelectorAll(".ingredient-checkbox")
            .forEach(x => x.checked = false);
    }

    document.getElementById("searchIngredient").addEventListener("input", function () {
        const keyword = this.value.toLowerCase();

        document.querySelectorAll(".ingredient-item").forEach(row => {
            const name = row.querySelector(".ingredient-name").innerText.toLowerCase();

            row.classList.toggle("d-none", !name.includes(keyword));
        });
    });</script>

</body>
</html>
