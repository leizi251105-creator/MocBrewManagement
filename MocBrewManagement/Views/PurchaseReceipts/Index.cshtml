
@model IEnumerable<MocBrewManagement.ViewModels.PurchaseReceiptViewModel>

@{
    ViewBag.Title = "Quản lý phiếu nhập hàng";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý phiếu nhập - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f3ef;
            font-family: Arial, sans-serif;
            color: #3b3029;
        }

        .main-container {
            padding: 35px;
        }

        .page-header {
            background: #fff;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .page-header h3 {
                font-weight: 700;
                color: #5b3927;
                margin: 0;
            }

        .btn-brown {
            background: #795238;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background: #5b3927;
                color: white;
            }

        .content-card {
            background: white;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 3px 15px rgba(0,0,0,.04);
        }

        .table thead th {
            background: #f4eee8;
            color: #5b3927;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .pending {
            background: #fff0cc;
            color: #966000;
        }

        .approved {
            background: #d9f2e3;
            color: #167343;
        }

        .rejected {
            background: #fce1e1;
            color: #b42318;
        }
    </style>
</head>

<body>
    <div class="main-container">

        <div class="page-header">
            <div>
                <h3><i class="fa-solid fa-truck-ramp-box me-2"></i>Quản lý phiếu nhập hàng</h3>
                <p class="text-muted mb-0 mt-2">
                    Theo dõi phiếu nhập nguyên liệu và đơn giá nhập thực tế
                </p>
            </div>


            <div class="d-flex gap-2">

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-outline-secondary px-4 py-2">
                    <i class="fa-solid fa-house me-2"></i>Quay về trang chủ
                </a>

                <a href="@Url.Action("Create", "PurchaseReceipts")"
                   class="btn btn-brown px-4 py-2">
                    <i class="fa-solid fa-plus me-2"></i>Tạo phiếu nhập
                </a>

            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="content-card">
            <div class="d-flex justify-content-between mb-3">
                <h5 class="fw-bold">Danh sách phiếu nhập</h5>
                <span class="text-muted">
                    Tổng số: @(Model == null ? 0 : Model.Count()) phiếu
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Ngày nhập</th>
                            <th>Nhà cung cấp</th>
                            <th>Nhân viên lập</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusClass = item.Status == "Pending"
                                    ? "pending"
                                    : item.Status == "Approved"
                                        ? "approved"
                                        : "rejected";

                                string statusText = item.Status == "Pending"
                                    ? "Chờ duyệt"
                                    : item.Status == "Approved"
                                        ? "Đã duyệt"
                                        : "Đã từ chối";

                                <tr>
                                    <td class="fw-bold">@item.ReceiptCode</td>
                                    <td>@item.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.SupplierName</td>
                                    <td>@item.EmployeeName</td>
                                    <td class="text-end fw-bold">
                                        @item.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td>
                                        <span class="status @statusClass">
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", "PurchaseReceipts",
                                        new { id = item.PurchaseReceiptId })"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fa-solid fa-eye"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-box-open fa-2x mb-3"></i>
                                    <p class="mb-0">Chưa có phiếu nhập hàng.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
