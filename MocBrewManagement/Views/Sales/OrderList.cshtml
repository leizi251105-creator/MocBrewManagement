
@model IEnumerable<MocBrewManagement.ViewModels.POSOrderListViewModel>

@{
    Layout = null;
    ViewBag.Title = "Danh sách đơn bán - MỘC BREW";

    string keyword = ViewBag.Keyword as string ?? "";
    string status = ViewBag.Status as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Roboto', sans-serif;
            background: #f7f4ef;
            color: #38271e;
        }

        .topbar {
            background: #38271e;
            color: white;
            padding: 22px 35px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 25px;
            font-weight: 700;
        }

        .topbar a {
            color: white;
            text-decoration: none;
        }

        .content {
            padding: 35px;
            max-width: 1250px;
            margin: auto;
        }

        .page-heading {
            margin-bottom: 28px;
        }

            .page-heading h2 {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .page-heading p {
                color: #927965;
                margin: 0;
            }

        .back-link {
            color: #795238;
            text-decoration: none;
            font-weight: 500;
        }

            .back-link:hover {
                color: #38271e;
            }

        .filter-card,
        .table-card {
            background: white;
            border: 1px solid #eee5dc;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: #38271e;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 500;
            color: #594536;
        }

        .form-control,
        .form-select {
            border: 1px solid #e5d9ce;
            border-radius: 8px;
            padding: 10px 12px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #a47a58;
                box-shadow: 0 0 0 0.2rem rgba(121, 82, 56, 0.12);
            }

        .btn-brown {
            background: #795238;
            border: 1px solid #795238;
            color: white;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 500;
        }

            .btn-brown:hover {
                background: #38271e;
                border-color: #38271e;
                color: white;
            }

        .btn-outline-brown {
            color: #795238;
            border: 1px solid #795238;
            border-radius: 8px;
            padding: 10px 18px;
            text-decoration: none;
            font-weight: 500;
        }

            .btn-outline-brown:hover {
                background: #795238;
                color: white;
            }

        .table {
            vertical-align: middle;
            margin-bottom: 0;
        }

            .table thead th {
                background: #f4e9df;
                color: #59402e;
                font-weight: 700;
                white-space: nowrap;
                padding: 15px 12px;
                border-bottom: 1px solid #eaded2;
            }

            .table tbody td {
                padding: 15px 12px;
                border-color: #f0e9e2;
                color: #594536;
            }

            .table tbody tr:hover {
                background: #fcfaf7;
            }

        .order-code {
            color: #795238;
            font-weight: 700;
            white-space: nowrap;
        }

        .customer-name {
            font-weight: 600;
            color: #38271e;
        }

        .customer-phone {
            color: #927965;
            font-size: 13px;
            margin-top: 4px;
        }

        .order-total {
            color: #795238;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-pending {
            background: #fff2d6;
            color: #9a6900;
        }

        .status-confirmed {
            background: #e1efff;
            color: #2463a5;
        }

        .status-preparing {
            background: #f0e6ff;
            color: #7040a0;
        }

        .status-completed {
            background: #e0f3e7;
            color: #287744;
        }

        .status-cancelled {
            background: #fbe5e3;
            color: #b13b32;
        }

        .status-default {
            background: #eee9e4;
            color: #66564a;
        }

        .payment-paid {
            color: #287744;
            font-weight: 600;
        }

        .payment-unpaid {
            color: #b7791f;
            font-weight: 600;
        }

        .fulfillment {
            white-space: nowrap;
            color: #594536;
        }

        .empty-state {
            text-align: center;
            padding: 45px 15px;
            color: #927965;
        }

            .empty-state i {
                font-size: 42px;
                color: #c9b5a3;
                margin-bottom: 15px;
            }

        .summary-text {
            color: #927965;
            font-size: 14px;
            margin-top: 18px;
        }

        .alert {
            border-radius: 10px;
        }

        @@media (max-width: 768px) {
            .content {
                padding: 20px;
            }

            .topbar {
                padding: 18px 20px;
            }

            .filter-card,
            .table-card {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <div class="brand">MỘC BREW</div>

        <a href="@Url.Action("Index", "Home")">
            <i class="fa-solid fa-house me-2"></i>
            Trang chủ
        </a>
    </header>

    <main class="content">

        <!-- TIÊU ĐỀ -->
        <div class="page-heading">

            <a href="@Url.Action("Index", "Sales")" class="back-link">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Quay lại quản lý bán hàng
            </a>

            <h2 class="mt-4">
                <i class="fa-solid fa-receipt me-2"></i>
                Danh sách đơn bán
            </h2>

            <p>
                Theo dõi và tìm kiếm các đơn hàng được tạo trực tiếp tại quầy POS.
            </p>

        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- NÚT TẠO ĐƠN -->
        <div class="d-flex justify-content-end mb-4">
            <a href="@Url.Action("Create", "Sales")" class="btn btn-brown">
                <i class="fa-solid fa-plus me-2"></i>
                Tạo đơn bán mới
            </a>
        </div>

        <!-- TÌM KIẾM VÀ LỌC -->
        <div class="filter-card">

            <h5 class="section-title">
                <i class="fa-solid fa-filter me-2"></i>
                Tìm kiếm và lọc đơn hàng
            </h5>

            @using (Html.BeginForm("OrderList", "Sales", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">

                    <div class="col-md-6">
                        <label class="form-label">Tìm kiếm đơn hàng</label>

                        <input type="text"
                               name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Nhập mã đơn, tên khách hàng hoặc số điện thoại..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Trạng thái đơn hàng</label>

                        <select name="status" class="form-select">
                            <option value="">Tất cả trạng thái</option>

                            <option value="Pending" @(status == "Pending" ? "selected" : "")>
                                Chờ xử lý
                            </option>

                            <option value="Confirmed" @(status == "Confirmed" ? "selected" : "")>
                                Đã xác nhận
                            </option>

                            <option value="Preparing" @(status == "Preparing" ? "selected" : "")>
                                Đang pha chế
                            </option>

                            <option value="Completed" @(status == "Completed" ? "selected" : "")>
                                Hoàn thành
                            </option>

                            <option value="Cancelled" @(status == "Cancelled" ? "selected" : "")>
                                Đã hủy
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-brown flex-grow-1">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>
                            Tìm kiếm
                        </button>
                    </div>

                </div>
            }

        </div>

        <!-- DANH SÁCH ĐƠN HÀNG -->
        <div class="table-card">

            <h5 class="section-title">
                <i class="fa-solid fa-list me-2"></i>
                Danh sách đơn hàng POS
            </h5>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Thời gian</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái đơn</th>
                                <th>Nhận hàng</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="order-code">
                                            @item.OrderCode
                                        </span>
                                    </td>

                                    <td>
                                        <div class="customer-name">
                                            @item.ReceiverName
                                        </div>

                                        <div class="customer-phone">
                                            <i class="fa-solid fa-phone me-1"></i>
                                            @item.ReceiverPhone
                                        </div>
                                    </td>

                                    <td>
                                        @item.OrderDate.ToString("dd/MM/yyyy")
                                        <div class="customer-phone">
                                            @item.OrderDate.ToString("HH:mm")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="order-total">
                                            @item.TotalAmount.ToString("N0") đ
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.PaymentStatus == "Paid")
                                        {
                                            <span class="payment-paid">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="payment-unpaid">
                                                <i class="fa-solid fa-clock me-1"></i>
                                                Chưa thanh toán
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.OrderStatus == "Pending")
                                        {
                                            <span class="status-badge status-pending">Chờ xử lý</span>
                                        }
                                        else if (item.OrderStatus == "Confirmed")
                                        {
                                            <span class="status-badge status-confirmed">Đã xác nhận</span>
                                        }
                                        else if (item.OrderStatus == "Preparing")
                                        {
                                            <span class="status-badge status-preparing">Đang pha chế</span>
                                        }
                                        else if (item.OrderStatus == "Completed")
                                        {
                                            <span class="status-badge status-completed">Hoàn thành</span>
                                        }
                                        else if (item.OrderStatus == "Cancelled")
                                        {
                                            <span class="status-badge status-cancelled">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-default">
                                                @item.OrderStatus
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="fulfillment">
                                            @if (item.FulfillmentMethod == "PICKUP")
                                            {
                                                <i class="fa-solid fa-store me-1"></i>
                                                @:Nhận tại quán
                                            }
                                            else if (item.FulfillmentMethod == "DELIVERY")
                                            {
                                                <i class="fa-solid fa-truck me-1"></i>
                                                @:Giao hàng
                                            }
                                            else
                                            {
                                                @item.FulfillmentMethod
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Sales", new { id = item.OrderId })"
                                           class="btn btn-sm"
                                           style="background:#795238; color:white; border-radius:6px; white-space:nowrap;">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>

                <div class="summary-text">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Tổng số đơn hàng: <strong>@Model.Count()</strong>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-solid fa-receipt d-block"></i>

                    <h5>Không tìm thấy đơn hàng</h5>

                    <p class="mb-0">
                        Không có đơn hàng phù hợp với thông tin tìm kiếm.
                    </p>
                </div>
            }

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
