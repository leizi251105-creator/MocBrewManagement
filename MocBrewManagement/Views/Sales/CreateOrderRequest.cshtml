
@model MocBrewManagement.ViewModels.OrderRequestViewModel

@{
    ViewBag.Title = "Gửi yêu cầu hủy đơn / hoàn tiền";
    Layout = null;

    bool isCancel = Model.RequestType == "Cancel";
    string requestTitle = isCancel
        ? "Yêu cầu hủy đơn hàng"
        : "Yêu cầu hoàn tiền";

    string requestDescription = isCancel
        ? "Gửi yêu cầu hủy đơn hàng đến Super Admin phê duyệt."
        : "Gửi yêu cầu hoàn tiền đến Super Admin phê duyệt.";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@requestTitle | MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f7f3ed;
            font-family: 'Roboto', sans-serif;
            color: #45352b;
        }

        .header {
            background: #4b3023;
            color: white;
            padding: 20px 35px;
        }

        .brand {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .main {
            max-width: 850px;
            margin: 45px auto;
            padding: 0 18px;
        }

        .request-card {
            background: white;
            border-radius: 14px;
            padding: 32px;
            box-shadow: 0 5px 25px rgba(70, 45, 30, .08);
        }

        .page-title {
            color: #573a28;
            font-weight: 700;
        }

        .info-box {
            background: #faf6f0;
            border: 1px solid #eadfd2;
            border-radius: 10px;
            padding: 20px;
            margin: 25px 0;
        }

        .info-label {
            color: #8b796a;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .info-value {
            font-weight: 600;
            color: #493527;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            border-radius: 8px;
            padding: 11px 13px;
        }

        .btn-brown {
            background: #795238;
            border: none;
            color: white;
            padding: 12px 22px;
            border-radius: 8px;
            font-weight: 600;
        }

            .btn-brown:hover {
                background: #5b3b28;
                color: white;
            }

        .btn-back {
            color: #795238;
            text-decoration: none;
            font-weight: 600;
        }

        .warning-box {
            background: #fff8e8;
            border: 1px solid #f1dfb4;
            color: #80602b;
            border-radius: 8px;
            padding: 13px;
        }
    </style>
</head>

<body>

    <div class="header">
        <div class="brand">
            <i class="fa-solid fa-mug-hot me-2"></i>
            MỘC BREW
        </div>
        <div class="small mt-1">Hệ thống quản lý cửa hàng</div>
    </div>

    <div class="main">

        <a href="@Url.Action("Details", "Sales", new { id = Model.OrderId })"
           class="btn-back">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Quay lại chi tiết đơn hàng
        </a>

        <div class="request-card mt-4">

            <h3 class="page-title">
                <i class="fa-solid @(isCancel ? "fa-ban" : "fa-money-bill-transfer") me-2"></i>
                @requestTitle
            </h3>

            <p class="text-muted mt-2">
                @requestDescription
            </p>

            <div class="info-box">

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="info-label">Mã đơn hàng</div>
                        <div class="info-value">@Model.OrderCode</div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Tổng tiền</div>
                        <div class="info-value">
                            @Model.TotalAmount.ToString("N0") VNĐ
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Trạng thái đơn hàng</div>
                        <div class="info-value">@Model.OrderStatus</div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Thanh toán</div>
                        <div class="info-value">@Model.PaymentStatus</div>
                    </div>

                </div>

            </div>

            <div class="warning-box mb-4">
                <i class="fa-solid fa-circle-info me-2"></i>
                Yêu cầu sẽ được gửi đến Super Admin để xem xét và phê duyệt.
                Đơn hàng chưa bị thay đổi trạng thái khi bạn gửi yêu cầu.
            </div>

            @using (Html.BeginForm("CreateOrderRequest", "Sales",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.OrderId)
                @Html.HiddenFor(m => m.RequestType)

                <div class="mb-3">
                    <label class="form-label">Lý do yêu cầu <span class="text-danger">*</span></label>

                    @Html.TextAreaFor(m => m.Reason,
                             new
                             {
                                 @class = "form-control",
                                 rows = "5",
                                 maxlength = "500",
                                 placeholder = "Nhập lý do hủy đơn hoặc hoàn tiền..."
                             })

                    @Html.ValidationMessageFor(m => m.Reason,
                             "",
                             new { @class = "text-danger small" })
                </div>

                @Html.ValidationMessageFor(m => m.RequestType,
                         "",
                         new { @class = "text-danger small d-block mb-3" })

                <div class="d-flex justify-content-end gap-2">

                    <a href="@Url.Action("Details", "Sales",
                        new { id = Model.OrderId })"
                       class="btn btn-outline-secondary px-4">
                        Quay lại
                    </a>

                    <button type="submit"
                            class="btn-brown"
                            onclick="return confirm('Bạn chắc chắn muốn gửi yêu cầu này?');">
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Gửi yêu cầu
                    </button>

                </div>
            }

        </div>

    </div>

</body>
</html>
