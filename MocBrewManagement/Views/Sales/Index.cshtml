
@{
    Layout = null;
    ViewBag.Title = "Quản lý bán hàng - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Roboto', sans-serif;
            background: #f7f4ef;
            color: #38271e;
        }

        .topbar {
            background: #38271e;
            color: white;
            padding: 22px 35px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 25px;
            font-weight: 700;
        }

        .topbar a {
            color: white;
            text-decoration: none;
        }

        .content {
            padding: 35px;
            max-width: 1250px;
            margin: auto;
        }

        .page-heading {
            margin-bottom: 28px;
        }

            .page-heading h2 {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .page-heading p {
                color: #927965;
                margin: 0;
            }

        .sales-card {
            display: block;
            height: 100%;
            background: white;
            border: 1px solid #eee5dc;
            border-radius: 14px;
            padding: 25px;
            color: #38271e;
            text-decoration: none;
            transition: 0.2s;
        }

            .sales-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(65, 42, 28, 0.09);
                color: #795238;
            }

        .sales-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #f4e9df;
            color: #795238;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-bottom: 20px;
        }

        .sales-card h5 {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .sales-card p {
            color: #8c7b6d;
            font-size: 14px;
            margin: 0;
            line-height: 1.6;
        }

        .back-link {
            color: #795238;
            text-decoration: none;
            font-weight: 500;
        }

            .back-link:hover {
                color: #38271e;
            }

        @@media (max-width: 768px) {
            .content {
                padding: 20px;
            }

            .topbar {
                padding: 18px 20px;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <div class="brand">MỘC BREW</div>

        <a href="@Url.Action("Index", "Home")">
            <i class="fa-solid fa-house me-2"></i>
            Trang chủ
        </a>
    </header>

    <main class="content">

        <div class="page-heading">
            <a href="@Url.Action("Index", "Home")"
               class="back-link">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Quay lại trang chủ
            </a>

            <h2 class="mt-4">Quản lý bán hàng</h2>

            <p>
                Quản lý các hoạt động bán hàng tại cửa hàng MỘC BREW.
            </p>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

    <div class="row g-4">
        <!-- TẠO ĐƠN BÁN HÀNG -->
        <div class="col-md-6 col-lg-4">
            <a href="@Url.Action("Create", "Sales")" class="sales-card">
                <div class="sales-icon">
                    <i class="fa-solid fa-cart-plus"></i>
                </div>

                <h5>Tạo đơn bán hàng</h5>

                <p>
                    Chọn sản phẩm, kích cỡ, số lượng và tạo đơn bán hàng mới.
                </p>
            </a>
        </div>

        <!-- DANH SÁCH ĐƠN BÁN -->
        <div class="col-md-6 col-lg-4">
            <a href="@Url.Action("OrderList", "Sales")" class="sales-card">
                <div class="sales-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>

                <h5>Danh sách đơn bán</h5>

                <p>
                    Theo dõi, tìm kiếm và xem chi tiết các đơn bán hàng.
                </p>
            </a>
        </div>

        <!-- THANH TOÁN -->
        <div class="col-md-6 col-lg-4">
            <a href="#" class="sales-card">
                <div class="sales-icon">
                    <i class="fa-solid fa-credit-card"></i>
                </div>

                <h5>Thanh toán</h5>

                <p>
                    Quản lý thanh toán tiền mặt và chuyển khoản.
                </p>
            </a>
        </div>

        <!-- HỦY ĐƠN VÀ HOÀN TIỀN -->
        <div class="col-md-6 col-lg-4">
            <a href="#" class="sales-card">
                <div class="sales-icon">
                    <i class="fa-solid fa-rotate-left"></i>
                </div>

                <h5>Hủy đơn / Hoàn tiền</h5>

                <p>
                    Theo dõi yêu cầu hủy đơn và hoàn tiền theo phân quyền.
                </p>
            </a>
        </div>

        <!-- IN HÓA ĐƠN -->
        <div class="col-md-6 col-lg-4">
            <a href="#" class="sales-card">
                <div class="sales-icon">
                    <i class="fa-solid fa-print"></i>
                </div>

                <h5>In hóa đơn</h5>

                <p>
                    Xem thông tin và in hóa đơn bán hàng cho khách.
                </p>
            </a>
        </div>

    </div>

    </main>

</body>
</html>
