
@model MocBrewManagement.ViewModels.SupplierViewModel

@{
    Layout = null;
    ViewBag.Title = "Thêm nhà cung cấp";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thêm nhà cung cấp - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f2ed;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .page {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .panel {
            background: white;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
        }

        .page-title {
            color: #68452f;
            font-weight: 700;
        }

        .btn-main {
            background: #68452f;
            color: white;
            border: none;
        }

            .btn-main:hover {
                background: #4e3323;
                color: white;
            }

        .form-label {
            font-weight: 600;
            color: #5b4739;
        }

        .required {
            color: #dc3545;
        }
    </style>
</head>

<body>
    <div class="page">

        <div class="mb-4">
            <h3 class="page-title">
                <i class="fa-solid fa-plus-circle me-2"></i>
                Thêm nhà cung cấp
            </h3>
            <div class="text-muted">
                Nhập thông tin nhà cung cấp nguyên liệu cho cửa hàng MỘC BREW
            </div>
        </div>

        <div class="panel">

            @using (Html.BeginForm("Create", "Suppliers", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    <label class="form-label">
                        Tên nhà cung cấp <span class="required">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.SupplierName, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập tên nhà cung cấp..."
                    })
                    @Html.ValidationMessageFor(m => m.SupplierName, "", new
                    {
                        @class = "text-danger"
                    })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone, new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: 0901234567"
                        })
                        @Html.ValidationMessageFor(m => m.Phone, "", new
                        {
                            @class = "text-danger"
                        })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            placeholder = "example@gmail.com"
                        })
                        @Html.ValidationMessageFor(m => m.Email, "", new
                        {
                            @class = "text-danger"
                        })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Địa chỉ</label>
                    @Html.TextAreaFor(m => m.Address, new
                    {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Nhập địa chỉ nhà cung cấp..."
                    })
                    @Html.ValidationMessageFor(m => m.Address, "", new
                    {
                        @class = "text-danger"
                    })
                </div>

                <div class="mb-4">
                    <label class="form-label">Mã số thuế</label>
                    @Html.TextBoxFor(m => m.TaxCode, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập mã số thuế..."
                    })
                    @Html.ValidationMessageFor(m => m.TaxCode, "", new
                    {
                        @class = "text-danger"
                    })
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index", "Suppliers")"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Quay lại
                    </a>

                    <button type="submit" class="btn btn-main">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Lưu nhà cung cấp
                    </button>
                </div>
            }

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
