
@model IEnumerable<MocBrewManagement.ViewModels.WorkShiftViewModel>

@{
    Layout = null;
    ViewBag.Title = "Quản lý ca làm việc - MỘC BREW";

    var currentShift = Model.FirstOrDefault(x => x.Status == "Open");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý ca làm việc - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f2ed;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .container-main {
            max-width: 1150px;
            margin: 40px auto;
            padding: 0 18px;
        }

        .brand {
            color: #70452e;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .card-custom {
            background: white;
            border: none;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 5px 22px rgba(0,0,0,.045);
        }

        .btn-brown {
            background: #70452e;
            color: white;
            border-radius: 9px;
            padding: 11px 18px;
            font-weight: 600;
        }

            .btn-brown:hover {
                background: #52321f;
                color: white;
            }

        .btn-close-shift {
            background: #a64b3c;
            color: white;
            border-radius: 9px;
            padding: 9px 15px;
            text-decoration: none;
        }

            .btn-close-shift:hover {
                background: #84372b;
                color: white;
            }

        .table thead th {
            background: #f4eee8;
            color: #63452f;
            white-space: nowrap;
        }

        .table td, .table th {
            padding: 14px;
            vertical-align: middle;
        }

        .status-open {
            background: #dff3e5;
            color: #237342;
        }

        .status-closed {
            background: #eee9e3;
            color: #665548;
        }

        .money {
            font-weight: 700;
            color: #70452e;
        }
    </style>
</head>

<body>
    <div class="container-main">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <div class="brand fs-4">MỘC BREW</div>
                <h3 class="fw-bold mt-2 mb-1">Quản lý ca làm việc</h3>
                <div class="text-secondary">
                    Theo dõi thời gian và đối soát tiền mặt theo ca
                </div>
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-outline-secondary">
                <i class="fa-solid fa-house me-2"></i>
                Trang chủ
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        @if (currentShift != null)
        {
            <div class="card-custom mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <span class="badge status-open px-3 py-2 mb-3">
                            <i class="fa-solid fa-circle me-1"></i>
                            ĐANG MỞ CA
                        </span>

                        <h4 class="fw-bold">
                            @currentShift.ShiftCode
                        </h4>

                        <div class="text-secondary">
                            Bắt đầu:
                            @currentShift.StartTime.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div class="mt-3">
                            Tiền mặt đầu ca:
                            <span class="money">
                                @currentShift.OpeningCash.ToString("N0") VNĐ
                            </span>
                        </div>
                    </div>

                    <a href="@Url.Action("Close", "WorkShifts",
                        new { id = currentShift.ShiftId })"
                       class="btn-close-shift">
                        <i class="fa-solid fa-lock me-2"></i>
                        Đóng ca
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card-custom mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h5 class="fw-bold mb-2">
                            <i class="fa-solid fa-clock me-2"></i>
                            Bạn chưa mở ca làm việc
                        </h5>

                        <div class="text-secondary">
                            Hãy mở ca và ghi nhận tiền mặt đầu ca trước khi bán hàng.
                        </div>
                    </div>

                    <a href="@Url.Action("Open", "WorkShifts")"
                       class="btn btn-brown">
                        <i class="fa-solid fa-play me-2"></i>
                        Mở ca mới
                    </a>
                </div>
            </div>
        }

        <div class="card-custom">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-list me-2"></i>
                    Lịch sử ca làm việc
                </h5>

                <span class="text-secondary">
                    Tổng số: @Model.Count() ca
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã ca</th>
                            <th>Thời gian bắt đầu</th>
                            <th>Thời gian kết thúc</th>
                            <th>Tiền đầu ca</th>
                            <th>Tiền dự kiến</th>
                            <th>Tiền thực tế</th>
                            <th>Chênh lệch</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @item.ShiftCode
                                    </td>

                                    <td>
                                        @item.StartTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(item.EndTime.HasValue
                                            ? item.EndTime.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "—")
                                    </td>

                                    <td>
                                        @item.OpeningCash.ToString("N0")
                                    </td>

                                    <td>
                                        @item.ExpectedCash.ToString("N0")
                                    </td>

                                    <td>
                                        @(item.ActualCash.HasValue
                                            ? item.ActualCash.Value.ToString("N0")
                                            : "—")
                                    </td>

                                    <td>
                                        @(item.CashDifference.HasValue
                                            ? item.CashDifference.Value.ToString("N0")
                                            : "—")
                                    </td>

                                    <td>
                                        @if (item.Status == "Open")
                                        {
                                            <span class="badge status-open">Đang mở</span>
                                        }
                                        else
                                        {
                                            <span class="badge status-closed">Đã đóng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-secondary py-4">
                                    Chưa có ca làm việc nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-center text-secondary mt-4 small">
            MỘC BREW · HỆ THỐNG QUẢN LÝ CỬA HÀNG
        </div>

    </div>
</body>
</html>
