
@model MocBrewManagement.ViewModels.WorkShiftCloseViewModel

@{
    Layout = null;
    ViewBag.Title = "Đóng ca làm việc - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Đóng ca làm việc - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f2ed;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .page-container {
            max-width: 760px;
            margin: 55px auto;
            padding: 0 18px;
        }

        .brand {
            color: #70452e;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .form-card {
            background: white;
            border-radius: 18px;
            padding: 35px;
            box-shadow: 0 8px 30px rgba(0,0,0,.06);
        }

        .icon-box {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            background: #f5e6e3;
            color: #a64b3c;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            margin-bottom: 20px;
        }

        .form-control {
            padding: 13px;
            border-radius: 10px;
        }

        .btn-close-custom {
            background: #a64b3c;
            color: white;
            padding: 13px 25px;
            border-radius: 10px;
            font-weight: 600;
        }

            .btn-close-custom:hover {
                background: #84372b;
                color: white;
            }

        .btn-light-custom {
            background: #eee9e3;
            color: #594536;
            padding: 13px 25px;
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <div class="page-container">

        <div class="mb-4">
            <div class="brand fs-4">MỘC BREW</div>
            <div class="text-secondary">QUẢN LÝ CA LÀM VIỆC</div>
        </div>

        <div class="form-card">

            <div class="icon-box">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h3 class="fw-bold mb-2">Đóng ca làm việc</h3>

            <p class="text-secondary mb-4">
                Vui lòng kiểm đếm tiền mặt thực tế tại quầy
                trước khi xác nhận đóng ca.
            </p>

            @using (Html.BeginForm("Close", "WorkShifts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.ShiftId)

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Tiền mặt thực tế cuối ca (VNĐ)
                    </label>

                    @Html.TextBoxFor(
                             m => m.ActualCash,
                             new
                             {
                                 @class = "form-control",
                                 type = "number",
                                 min = "0",
                                 step = "1000",
                                 required = "required"
                             }
                         )

                    @Html.ValidationMessageFor(
                             m => m.ActualCash,
                             "",
                             new { @class = "text-danger" }
                         )
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Ghi chú khi đóng ca
                    </label>

                    @Html.TextAreaFor(
                             m => m.Note,
                             new
                             {
                                 @class = "form-control",
                                 rows = "3",
                                 placeholder = "Ví dụ: Bàn giao tiền mặt cho quản lý..."
                             }
                         )
                </div>

                <div class="alert alert-warning">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Hệ thống sẽ tính chênh lệch giữa tiền mặt thực tế
                    và tiền mặt dự kiến khi xác nhận đóng ca.
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-close-custom">
                        <i class="fa-solid fa-lock me-2"></i>
                        Xác nhận đóng ca
                    </button>

                    <a href="@Url.Action("Index", "WorkShifts")"
                       class="btn btn-light-custom">
                        Quay lại
                    </a>
                </div>
            }
        </div>

        <div class="text-center text-secondary mt-4 small">
            MỘC BREW · HỆ THỐNG QUẢN LÝ CỬA HÀNG
        </div>

    </div>
</body>
</html>
