
@{
    Layout = null;
    ViewBag.Title = "Mở ca làm việc - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mở ca làm việc - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f2ed;
            font-family: Arial, sans-serif;
            color: #3d3028;
        }

        .page-container {
            max-width: 760px;
            margin: 55px auto;
            padding: 0 18px;
        }

        .brand {
            color: #70452e;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .form-card {
            background: white;
            border-radius: 18px;
            padding: 35px;
            box-shadow: 0 8px 30px rgba(0,0,0,.06);
        }

        .icon-box {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            background: #f2e7dc;
            color: #815438;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            margin-bottom: 20px;
        }

        .form-control {
            padding: 13px;
            border-radius: 10px;
        }

        .btn-brown {
            background: #70452e;
            color: white;
            padding: 13px 25px;
            border-radius: 10px;
            font-weight: 600;
        }

            .btn-brown:hover {
                background: #52321f;
                color: white;
            }

        .btn-light-custom {
            background: #eee9e3;
            color: #594536;
            padding: 13px 25px;
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <div class="page-container">

        <div class="mb-4">
            <div class="brand fs-4">MỘC BREW</div>
            <div class="text-secondary">QUẢN LÝ CA LÀM VIỆC</div>
        </div>

        <div class="form-card">
            <div class="icon-box">
                <i class="fa-solid fa-cash-register"></i>
            </div>

            <h3 class="fw-bold mb-2">Mở ca làm việc</h3>

            <p class="text-secondary mb-4">
                Vui lòng kiểm tra và nhập số tiền mặt hiện có tại quầy
                trước khi bắt đầu ca.
            </p>

            @using (Html.BeginForm("Open", "WorkShifts",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Tiền mặt đầu ca (VNĐ)
                    </label>

                    <input type="number"
                           name="openingCash"
                           class="form-control"
                           min="0"
                           step="1000"
                           value="0"
                           required />

                    @Html.ValidationMessage(
                             "openingCash",
                             "",
                             new { @class = "text-danger" }
                         )
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Ghi chú
                    </label>

                    <textarea name="note"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập ghi chú nếu có..."></textarea>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-brown">
                        <i class="fa-solid fa-play me-2"></i>
                        Bắt đầu ca
                    </button>

                    <a href="@Url.Action("Index", "WorkShifts")"
                       class="btn btn-light-custom">
                        Quay lại
                    </a>
                </div>
            }
        </div>

        <div class="text-center text-secondary mt-4 small">
            MỘC BREW · HỆ THỐNG QUẢN LÝ CỬA HÀNG
        </div>

    </div>
</body>
</html>
