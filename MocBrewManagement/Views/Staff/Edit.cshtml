
@model MocBrewManagement.Models.StaffEditViewModel

@{
    ViewBag.Title = "Chỉnh sửa nhân viên";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Chỉnh sửa nhân viên - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <style>
        body {
            background: #f7f5f1;
            color: #35251c;
            font-family: 'DM Sans', Arial, sans-serif;
            margin: 0;
        }

        .topbar {
            background: #35251c;
            color: white;
            padding: 18px 35px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 23px;
            font-weight: 700;
        }

        .back-link {
            color: #eadfd3;
            text-decoration: none;
            font-size: 13px;
        }

            .back-link:hover {
                color: white;
            }

        .page {
            max-width: 850px;
            margin: 35px auto;
            padding: 0 18px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-description {
            color: #918478;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .form-panel {
            background: white;
            border: 1px solid #eee9e2;
            border-radius: 13px;
            padding: 30px;
        }

        .section-title {
            font-weight: 700;
            font-size: 15px;
            padding-bottom: 14px;
            margin-bottom: 20px;
            border-bottom: 1px solid #eee9e2;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            min-height: 43px;
            border: 1px solid #e8e1d9;
            border-radius: 8px;
            font-size: 13px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #98765d;
                box-shadow: 0 0 0 3px rgba(121,84,60,.09);
            }

        .hint {
            font-size: 11px;
            color: #918478;
            margin-top: 6px;
        }

        .btn-coffee {
            background: #79543c;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 13px;
            font-weight: 600;
        }

            .btn-coffee:hover {
                background: #5c3d2c;
                color: white;
            }

        .btn-cancel {
            background: white;
            color: #79543c;
            border: 1px solid #e8e1d9;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 13px;
            text-decoration: none;
        }

        .text-danger {
            font-size: 12px;
        }

        @@media (max-width: 576px) {
            .form-panel {
                padding: 20px;
            }

            .topbar {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <div class="brand">
            <i class="fa-solid fa-mug-hot me-2"></i>MỘC BREW
        </div>

        <a href="@Url.Action("Index", "Staff")" class="back-link">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Quay lại danh sách
        </a>
    </header>

    <main class="page">

        <h2 class="page-title">Chỉnh sửa nhân viên</h2>

        <p class="page-description">
            Cập nhật thông tin tài khoản nhân viên trong hệ thống.
        </p>

        <div class="form-panel">

            @using (Html.BeginForm("Edit", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.AccountId)

                <div class="section-title">
                    <i class="fa-solid fa-user me-2"
                       style="color:#79543c"></i>
                    Thông tin nhân viên
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Mã nhân viên *</label>
                        @Html.TextBoxFor(m => m.EmployeeCode,
                                 new { @class = "form-control", placeholder = "Ví dụ: NV02" })
                        @Html.ValidationMessageFor(m => m.EmployeeCode,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Họ và tên *</label>
                        @Html.TextBoxFor(m => m.FullName,
                                 new { @class = "form-control", placeholder = "Nhập họ và tên" })
                        @Html.ValidationMessageFor(m => m.FullName,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tên đăng nhập *</label>
                        @Html.TextBoxFor(m => m.Username,
                                 new { @class = "form-control", placeholder = "Tên đăng nhập" })
                        @Html.ValidationMessageFor(m => m.Username,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vai trò *</label>
                        @Html.DropDownListFor(m => m.RoleId,
                                 (SelectList)ViewBag.RoleList,
                                 "-- Chọn vai trò --",
                                 new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.RoleId,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.Email,
                                 new { @class = "form-control", placeholder = "example@gmail.com" })
                        @Html.ValidationMessageFor(m => m.Email,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone,
                                 new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                        @Html.ValidationMessageFor(m => m.Phone,
                                 "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12">
                        <div class="section-title mt-3">
                            <i class="fa-solid fa-lock me-2"
                               style="color:#79543c"></i>
                            Đổi mật khẩu
                        </div>

                        <label class="form-label">Mật khẩu mới</label>

                        @Html.PasswordFor(m => m.NewPassword,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Để trống nếu không muốn đổi mật khẩu"
                                 })

                        @Html.ValidationMessageFor(m => m.NewPassword,
                                 "", new { @class = "text-danger" })

                        <div class="hint">
                            Mật khẩu mới phải có ít nhất 6 ký tự.
                            Nếu để trống, mật khẩu hiện tại sẽ được giữ nguyên.
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a href="@Url.Action("Index", "Staff")"
                       class="btn-cancel">
                        Hủy
                    </a>

                    <button type="submit" class="btn-coffee">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu thay đổi
                    </button>

                </div>
            }

        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
