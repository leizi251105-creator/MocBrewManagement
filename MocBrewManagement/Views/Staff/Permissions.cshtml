
@model MocBrewManagement.Models.StaffPermissionViewModel

@{
    Layout = null;
    ViewBag.Title = "Phân quyền nhân viên - MỘC BREW";

    int totalPermissions = Model.Permissions.Count;
    int grantedPermissions = Model.Permissions.Count(p => p.IsGranted);

    var groups = new[]
    {
        new { Name = "Quản trị hệ thống", Icon = "fa-gears", Codes = new[] { "SYS_CONFIG", "SYS_BACKUP", "SYS_ERRORLOG", "SYS_PRINTER", "SYS_VIETQR" } },
        new { Name = "Quản lý nhân viên", Icon = "fa-users", Codes = new[] { "STAFF_MANAGE", "STAFF_PERMISSION_ASSIGN" } },
        new { Name = "Bán hàng POS", Icon = "fa-cash-register", Codes = new[] { "POS_CREATE", "POS_PAYMENT", "POS_DISCOUNT" } },
        new { Name = "Quản lý đơn hàng", Icon = "fa-receipt", Codes = new[] { "ORDER_CANCEL", "ORDER_REFUND", "ORDER_VIEW_ALL", "ORDER_VIEW_OWN_SHIFT" } },
        new { Name = "Màn hình pha chế", Icon = "fa-blender", Codes = new[] { "KDS_VIEW", "KDS_COMPLETE", "KDS_OUT_OF_STOCK" } },
        new { Name = "Quản lý khách hàng", Icon = "fa-user-group", Codes = new[] { "CUSTOMER_VIEW", "CUSTOMER_EDIT", "CUSTOMER_POINTS", "CUSTOMER_DELETE", "CUSTOMER_EXPORT" } },
        new { Name = "Thực đơn và công thức", Icon = "fa-mug-hot", Codes = new[] { "MENU_VIEW", "MENU_MANAGE", "RECIPE_VIEW", "RECIPE_MANAGE" } },
        new { Name = "Kho và nhập hàng", Icon = "fa-boxes-stacked", Codes = new[] { "INVENTORY_VIEW", "INVENTORY_STOCKTAKE", "INVENTORY_ADJUST", "SUPPLIER_MANAGE", "PURCHASE_CREATE", "PURCHASE_APPROVE", "INVENTORY_WRITE_OFF" } },
        new { Name = "Báo cáo", Icon = "fa-chart-column", Codes = new[] { "REPORT_SHIFT_VIEW", "REPORT_REVENUE_VIEW", "REPORT_PROFIT_VIEW", "REPORT_INVENTORY_VIEW" } }
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Roboto', sans-serif;
            background: #f7f4ef;
            color: #38271e;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #38271e;
            color: white;
            padding: 25px 16px;
            overflow-y: auto;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 25px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 35px;
            color: #f4dfc1;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 15px;
            margin-bottom: 8px;
            border-radius: 9px;
            text-decoration: none;
            color: #e8ddd2;
            transition: 0.2s;
        }

            .menu-link:hover,
            .menu-link.active {
                background: #75513d;
                color: white;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            font-weight: 700;
        }

        .card-custom {
            background: white;
            border: none;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 4px 18px rgba(56, 39, 30, 0.06);
            margin-bottom: 22px;
        }

        .info-label {
            color: #8a7b70;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .info-value {
            font-weight: 700;
            font-size: 16px;
        }

        .stat-card {
            background: white;
            padding: 20px;
            border-radius: 13px;
            box-shadow: 0 4px 18px rgba(56, 39, 30, 0.05);
            height: 100%;
        }

        .stat-number {
            font-size: 27px;
            font-weight: 700;
            color: #75513d;
        }

        .permission-group {
            border: 1px solid #eee7df;
            border-radius: 12px;
            margin-bottom: 18px;
            overflow: hidden;
        }

        .group-header {
            background: #f5eee7;
            padding: 15px 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .group-body {
            padding: 15px 18px;
        }

        .permission-item {
            padding: 12px;
            border-bottom: 1px solid #f0ece7;
        }

            .permission-item:last-child {
                border-bottom: none;
            }

        .permission-name {
            font-weight: 600;
        }

        .permission-code {
            font-size: 12px;
            color: #9a8b80;
        }

        .permission-description {
            font-size: 13px;
            color: #8a7b70;
            margin-top: 4px;
        }

        .form-check-input {
            width: 19px;
            height: 19px;
            cursor: pointer;
        }

            .form-check-input:checked {
                background-color: #75513d;
                border-color: #75513d;
            }

        .btn-coffee {
            background: #75513d;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
        }

            .btn-coffee:hover {
                background: #38271e;
                color: white;
            }

        .btn-outline-coffee {
            color: #75513d;
            border: 1px solid #75513d;
            padding: 10px 20px;
            border-radius: 8px;
        }

            .btn-outline-coffee:hover {
                background: #75513d;
                color: white;
            }

        .btn-save-permission {
            background: #795238;
            color: white;
            border: 1px solid #795238;
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
        }

            .btn-save-permission:hover {
                background: #4b3022;
                border-color: #4b3022;
                color: white;
            }

        .permission-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main-content {
                margin-left: 0;
                padding: 18px;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="brand">
            <i class="fa-solid fa-mug-hot"></i>
            MỘC BREW
        </div>

        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="fa-solid fa-house"></i>
            Trang chủ
        </a>

        <a href="@Url.Action("Index", "Staff")" class="menu-link active">
            <i class="fa-solid fa-users"></i>
            Nhân viên và phân quyền
        </a>

        @if (Convert.ToInt32(Session["MOCBREW_RoleId"]) == 1)
        {
            <a href="@Url.Action("Index", "SystemLog")" class="menu-link">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Nhật ký hoạt động
            </a>
        }

        <a href="@Url.Action("Logout", "MocBrewAuth")" class="menu-link">
            <i class="fa-solid fa-right-from-bracket"></i>
            Đăng xuất
        </a>

    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="topbar">
            <div>
                <div class="page-title">
                    <i class="fa-solid fa-user-shield me-2"></i>
                    Phân quyền nhân viên
                </div>
                <div class="text-muted mt-1">
                    Quản lý quyền truy cập theo từng tài khoản nhân viên
                </div>
            </div>

            <div class="text-end">
                <div class="fw-bold">@Session["MOCBREW_FullName"]</div>
                <small class="text-muted">@ViewBag.CurrentRoleName</small>
            </div>
        </div>

        <!-- THÔNG TIN NHÂN VIÊN -->
        <div class="card-custom">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-id-card me-2"></i>
                    Thông tin nhân viên
                </h5>

                <a href="@Url.Action("Index", "Staff")"
                   class="btn btn-outline-coffee">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Quay lại
                </a>
            </div>

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="info-label">Mã nhân viên</div>
                    <div class="info-value">
                        @(Model.EmployeeCode ?? "Chưa có")
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Họ và tên</div>
                    <div class="info-value">@Model.FullName</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Tên đăng nhập</div>
                    <div class="info-value">@Model.Username</div>
                </div>

                <div class="col-md-3">
                    <div class="info-label">Vai trò</div>
                    <div class="info-value">Staff</div>
                </div>
            </div>

        </div>

        <!-- THỐNG KÊ QUYỀN -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="stat-card">
                    <div class="text-muted">Tổng số quyền hệ thống</div>
                    <div class="stat-number">@totalPermissions</div>
                    <small class="text-muted">Quyền được khai báo trong hệ thống</small>
                </div>
            </div>

            <div class="col-md-6">
                <div class="stat-card">
                    <div class="text-muted">Quyền đang được cấp</div>
                    <div class="stat-number" id="grantedCount">@grantedPermissions</div>
                    <small class="text-muted">Số quyền hiện đang bật</small>
                </div>
            </div>

        </div>

        <!-- DANH SÁCH QUYỀN -->
        <div class="card-custom">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fa-solid fa-list-check me-2"></i>
                        Danh sách quyền
                    </h5>
                    <small class="text-muted">
                        Tích chọn quyền muốn cấp cho nhân viên
                    </small>
                </div>
            </div>

            @using (Html.BeginForm(
                "SavePermissions",
                "Staff",
                new { id = Model.AccountId },
                FormMethod.Post,
                new { id = "permissionForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="permission-toolbar mb-4">

                    <button type="button"
                            class="btn btn-outline-coffee"
                            onclick="setAllPermissions(true)">
                        <i class="fa-solid fa-check-double me-1"></i>
                        Chọn tất cả
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="setAllPermissions(false)">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Bỏ chọn tất cả
                    </button>

                </div>

                foreach (var group in groups)
                {
                    var items = Model.Permissions
                        .Where(p => group.Codes.Contains(p.PermissionCode))
                        .ToList();

                    if (items.Any())
                    {
                        <div class="permission-group">

                            <div class="group-header">
                                <i class="fa-solid @group.Icon"></i>
                                @group.Name

                                <span class="badge bg-secondary ms-auto">
                                    @items.Count quyền
                                </span>
                            </div>

                            <div class="group-body">

                                @foreach (var permission in items)
                                {
                                    <div class="permission-item d-flex align-items-start gap-3">

                                        <input type="checkbox"
                                               class="form-check-input permission-checkbox mt-1"
                                               id="permission_@permission.PermissionId"
                                               name="selectedPermissionIds"
                                               value="@permission.PermissionId"
                                               @(permission.IsGranted ? "checked=\"checked\"" : "") />

                                        <label for="permission_@permission.PermissionId"
                                               class="flex-grow-1">

                                            <div class="permission-name">
                                                @permission.PermissionName
                                            </div>

                                            <div class="permission-code">
                                                @permission.PermissionCode
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(permission.Description))
                                            {
                                                <div class="permission-description">
                                                    @permission.Description
                                                </div>
                                            }

                                        </label>

                                    </div>
                                }

                            </div>
                        </div>
                    }
                }

                <!-- NÚT LƯU PHÂN QUYỀN -->
                <div class="d-flex justify-content-end gap-3 mt-4 pt-3"
                     style="border-top: 1px solid #eee5dc;">

                    <a href="@Url.Action("Index", "Staff")"
                       class="btn btn-outline-secondary px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Quay lại
                    </a>

                    <button type="submit"
                            class="btn btn-save-permission px-4">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu phân quyền
                    </button>

                </div>
            }

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function updateGrantedCount() {
            const checked = document.querySelectorAll(
                '.permission-checkbox:checked'
            );

            document.getElementById('grantedCount').textContent =
                checked.length;
        }

        function setAllPermissions(checked) {
            document.querySelectorAll('.permission-checkbox')
                .forEach(function (checkbox) {
                    checkbox.checked = checked;
                });

            updateGrantedCount();
        }

        document.querySelectorAll('.permission-checkbox')
            .forEach(function (checkbox) {
                checkbox.addEventListener('change', updateGrantedCount);
            });
    </script>

</body>
</html>
