
@model MocBrewManagement.Models.StaffCreateViewModel

@{
    ViewBag.Title = "Thêm nhân viên";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Thêm nhân viên - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f5f3ef;
            font-family: Arial, sans-serif;
            color: #35251c;
        }

        .topbar {
            background: #3b281f;
            color: white;
            padding: 20px 30px;
        }

        .container-main {
            padding: 35px;
            max-width: 1000px;
            margin: auto;
        }

        .form-card {
            background: white;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
        }

        .page-title {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .form-label {
            font-weight: 600;
            color: #4b3428;
        }

        .form-control, .form-select {
            padding: 11px 13px;
            border-radius: 8px;
        }

            .form-control:focus, .form-select:focus {
                border-color: #79543c;
                box-shadow: 0 0 0 .2rem rgba(121,84,60,.15);
            }

        .btn-coffee {
            background: #79543c;
            color: white;
            padding: 11px 22px;
            border: none;
        }

            .btn-coffee:hover {
                background: #5c3d2c;
                color: white;
            }

        .required {
            color: #dc3545;
        }

        .section-title {
            color: #79543c;
            font-weight: 700;
            border-bottom: 1px solid #eee5dc;
            padding-bottom: 12px;
            margin-bottom: 22px;
        }

        @@media (max-width: 576px) {
            .container-main {
                padding: 18px;
            }

            .form-card {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <div class="topbar d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1">
                <i class="fa-solid fa-mug-hot me-2"></i>
                MỘC BREW
            </h4>
            <small>Hệ thống quản lý cửa hàng</small>
        </div>

        <a href="@Url.Action("Index", "Staff")"
           class="btn btn-outline-light">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>

    <div class="container-main">

        <div class="mb-4">
            <h2 class="page-title">Thêm nhân viên</h2>
            <p class="text-muted mb-0">
                Nhập thông tin để tạo tài khoản nhân viên mới cho MỘC BREW.
            </p>
        </div>

        <div class="form-card">

            @using (Html.BeginForm("Create", "Staff", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <h5 class="section-title">
                    <i class="fa-solid fa-user me-2"></i>
                    Thông tin nhân viên
                </h5>

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label">
                            Mã nhân viên <span class="required">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.EmployeeCode,
                                 new { @class = "form-control", placeholder = "Ví dụ: NV02" })
                        @Html.ValidationMessageFor(m => m.EmployeeCode, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Họ và tên <span class="required">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.FullName,
                                 new { @class = "form-control", placeholder = "Nhập họ và tên" })
                        @Html.ValidationMessageFor(m => m.FullName, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Tên đăng nhập <span class="required">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Username,
                                 new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
                        @Html.ValidationMessageFor(m => m.Username, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Mật khẩu <span class="required">*</span>
                        </label>
                        @Html.PasswordFor(m => m.Password,
                                 new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                        @Html.ValidationMessageFor(m => m.Password, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.Email,
                                 new { @class = "form-control", placeholder = "example@email.com" })
                        @Html.ValidationMessageFor(m => m.Email, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone,
                                 new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                        @Html.ValidationMessageFor(m => m.Phone, "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Vai trò <span class="required">*</span>
                        </label>

                        @Html.DropDownListFor(m => m.RoleId,
                                 (SelectList)ViewBag.RoleList,
                                 "-- Chọn vai trò --",
                                 new { @class = "form-select" })

                        @Html.ValidationMessageFor(m => m.RoleId, "",
                                 new { @class = "text-danger small" })
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a href="@Url.Action("Index", "Staff")"
                       class="btn btn-light border px-4">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-coffee">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu tài khoản
                    </button>
                </div>
            }

        </div>
    </div>

</body>
</html>
